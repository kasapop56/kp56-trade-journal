// \uc0\u9562 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9565 \
\
void SVP_FullRebuild()\
\{\
   MqlRates m1[];\
   datetime endTime   = TimeCurrent();\
   datetime startTime = endTime - 3 * 86400;\
   int copied = CopyRates(_Symbol, PERIOD_M1, startTime, endTime, m1);\
   if(copied <= 0) \{ if(InpDebugPrint) Print("SVP v3.0: No M1 data available"); return; \}\
   double rowSize = InpRowSize_Points * g_Pt;\
   g_DayCount = 0;\
   ArrayResize(g_Days, 0, 5);\
   for(int i = 0; i < copied; i++)\
   \{\
      ENUM_SESSION_TYPE sType;\
      if(!SVP_GetSessionType(m1[i].time, sType)) continue;\
      datetime tradingDate = SVP_GetTradingDate(m1[i].time);\
      int dIdx = SVP_FindOrCreateDay(tradingDate);\
      if(dIdx < 0) continue;\
      if(m1[i].high > g_Days[dIdx].dayHigh) g_Days[dIdx].dayHigh = m1[i].high;\
      if(m1[i].low < g_Days[dIdx].dayLow)   g_Days[dIdx].dayLow  = m1[i].low;\
      g_Days[dIdx].dayTotalVol += (double)m1[i].tick_volume;\
      if(g_Days[dIdx].firstBarTime == 0 || m1[i].time < g_Days[dIdx].firstBarTime)\
         g_Days[dIdx].firstBarTime = m1[i].time;\
      int sIdx = (int)sType;\
      if(g_Days[dIdx].sessions[sIdx].tStart == 0 || m1[i].time < g_Days[dIdx].sessions[sIdx].tStart)\
         g_Days[dIdx].sessions[sIdx].tStart = m1[i].time;\
      g_Days[dIdx].sessions[sIdx].totalVol += (double)m1[i].tick_volume;\
   \}\
   SVP_TrimToTwoDays();\
   for(int d = 0; d < g_DayCount; d++)\
   \{ if(g_Days[d].dayHigh <= g_Days[d].dayLow) continue; SVP_BuildDayRows(d, rowSize); \}\
   for(int i = 0; i < copied; i++)\
   \{\
      ENUM_SESSION_TYPE sType;\
      if(!SVP_GetSessionType(m1[i].time, sType)) continue;\
      if(m1[i].tick_volume == 0) continue;\
      datetime tradingDate = SVP_GetTradingDate(m1[i].time);\
      int dIdx = -1;\
      for(int d = 0; d < g_DayCount; d++)\
         if(g_Days[d].date == tradingDate) \{ dIdx = d; break; \}\
      if(dIdx < 0 || g_Days[dIdx].rowCount == 0) continue;\
      SVP_DistributeBarVolume(dIdx, sType, m1[i].high, m1[i].low, m1[i].close, m1[i].tick_volume, rowSize);\
   \}\
   for(int d = 0; d < g_DayCount; d++) SVP_CalcDayLevels(d, rowSize);\
   if(g_DayCount > 0)\
   \{\
      for(int d = 0; d < g_DayCount; d++) g_Days[d].isToday = false;\
      g_Days[g_DayCount - 1].isToday = true;\
   \}\
\}\
\
void SVP_TrimToTwoDays()\
\{\
   if(g_DayCount <= 2) return;\
   int keep = 2, remove = g_DayCount - keep;\
   for(int i = 0; i < keep; i++) g_Days[i] = g_Days[i + remove];\
   g_DayCount = keep;\
   ArrayResize(g_Days, g_DayCount);\
\}\
\
bool SVP_GetSessionType(datetime dt, ENUM_SESSION_TYPE &sType)\
\{\
   MqlDateTime mdt; TimeToStruct(dt, mdt); int h = mdt.hour;\
   if(InpNY_StartH < InpNY_EndH)\
   \{ if(h >= InpNY_StartH && h < InpNY_EndH) \{ sType = SESSION_NEWYORK; return true; \} \}\
   else \{ if(h >= InpNY_StartH || h < InpNY_EndH) \{ sType = SESSION_NEWYORK; return true; \} \}\
   if(InpLondon_StartH < InpLondon_EndH)\
   \{ if(h >= InpLondon_StartH && h < InpLondon_EndH) \{ sType = SESSION_LONDON; return true; \} \}\
   else \{ if(h >= InpLondon_StartH || h < InpLondon_EndH) \{ sType = SESSION_LONDON; return true; \} \}\
   if(InpAsia_StartH < InpAsia_EndH)\
   \{ if(h >= InpAsia_StartH && h < InpAsia_EndH) \{ sType = SESSION_ASIA; return true; \} \}\
   else \{ if(h >= InpAsia_StartH || h < InpAsia_EndH) \{ sType = SESSION_ASIA; return true; \} \}\
   return false;\
\}\
\
datetime SVP_GetTradingDate(datetime barTime)\
\{\
   MqlDateTime mdt; TimeToStruct(barTime, mdt);\
   if(mdt.hour < InpAsia_StartH) \{ barTime -= 86400; TimeToStruct(barTime, mdt); \}\
   mdt.hour = 0; mdt.min = 0; mdt.sec = 0;\
   return StructToTime(mdt);\
\}\
\
int SVP_FindOrCreateDay(datetime tradingDate)\
\{\
   for(int i = 0; i < g_DayCount; i++) if(g_Days[i].date == tradingDate) return i;\
   ArrayResize(g_Days, g_DayCount + 1);\
   SDayProfile d;\
   d.date = tradingDate; d.dayHigh = -DBL_MAX; d.dayLow = DBL_MAX;\
   d.dayTotalVol = 0; d.rowCount = 0;\
   d.compositePOC = 0; d.compositeVAH = 0; d.compositeVAL = 0;\
   d.isToday = false; d.firstBarTime = 0;\
   for(int s = 0; s < 3; s++)\
   \{ d.sessions[s].pocPrice=0; d.sessions[s].vahPrice=0; d.sessions[s].valPrice=0; d.sessions[s].totalVol=0; d.sessions[s].tStart=0; \}\
   g_Days[g_DayCount] = d; g_DayCount++;\
   return g_DayCount - 1;\
\}\
\
void SVP_BuildDayRows(int dIdx, double rowSize)\
\{\
   double dH = g_Days[dIdx].dayHigh, dL = g_Days[dIdx].dayLow;\
   int numRows = (int)MathCeil((dH - dL) / rowSize) + 1;\
   if(numRows <= 0 || numRows > 1000) return;\
   ArrayResize(g_Days[dIdx].rows, numRows);\
   g_Days[dIdx].rowCount = numRows;\
   for(int r = 0; r < numRows; r++)\
   \{ g_Days[dIdx].rows[r].price = dL + r * rowSize + rowSize / 2.0; g_Days[dIdx].rows[r].totalVol = 0; g_Days[dIdx].rows[r].asiaVol = 0; g_Days[dIdx].rows[r].londonVol = 0; g_Days[dIdx].rows[r].nyVol = 0; \}\
\}\
\
void SVP_DistributeBarVolume(int dIdx, ENUM_SESSION_TYPE sType, double bH, double bL, double bC, long vol, double rowSize)\
\{\
   double dL = g_Days[dIdx].dayLow;\
   int numRows = g_Days[dIdx].rowCount;\
   int rStart = MathMax(0, (int)MathFloor((bL - dL) / rowSize));\
   int rEnd   = MathMin(numRows - 1, (int)MathFloor((bH - dL) / rowSize));\
   int covered = rEnd - rStart + 1;\
   if(covered <= 0) return;\
   double closeRow = (bC - dL) / rowSize;\
   double totalW = 0;\
   double weights[];\
   ArrayResize(weights, covered);\
   for(int r = 0; r < covered; r++)\
   \{ double dist = MathAbs((double)(rStart + r) + 0.5 - closeRow); weights[r] = MathMax(0.3, 1.0 - dist / MathMax((double)covered, 1.0)); totalW += weights[r]; \}\
   if(totalW <= 0) return;\
   for(int r = 0; r < covered; r++)\
   \{\
      int idx = rStart + r;\
      double v = (double)vol * weights[r] / totalW;\
      g_Days[dIdx].rows[idx].totalVol += v;\
      switch(sType)\
      \{ case SESSION_ASIA: g_Days[dIdx].rows[idx].asiaVol += v; break; case SESSION_LONDON: g_Days[dIdx].rows[idx].londonVol += v; break; case SESSION_NEWYORK: g_Days[dIdx].rows[idx].nyVol += v; break; \}\
   \}\
\}\
\
void SVP_CalcDayLevels(int dIdx, double rowSize)\
\{\
   int nRows = g_Days[dIdx].rowCount;\
   if(nRows == 0) return;\
   double maxVol = 0; int pocIdx = 0;\
   for(int r = 0; r < nRows; r++) \{ if(g_Days[dIdx].rows[r].totalVol > maxVol) \{ maxVol = g_Days[dIdx].rows[r].totalVol; pocIdx = r; \} \}\
   g_Days[dIdx].compositePOC = g_Days[dIdx].rows[pocIdx].price;\
   double target = g_Days[dIdx].dayTotalVol * (InpVA_Percent / 100.0);\
   double accum = g_Days[dIdx].rows[pocIdx].totalVol;\
   int upper = pocIdx, lower = pocIdx;\
   while(accum < target)\
   \{\
      double vUp = (upper + 1 < nRows) ? g_Days[dIdx].rows[upper + 1].totalVol : 0;\
      double vDn = (lower - 1 >= 0) ? g_Days[dIdx].rows[lower - 1].totalVol : 0;\
      if(vUp == 0 && vDn == 0) break;\
      if(vUp >= vDn) \{ upper++; accum += g_Days[dIdx].rows[upper].totalVol; \}\
      else           \{ lower--; accum += g_Days[dIdx].rows[lower].totalVol; \}\
   \}\
   g_Days[dIdx].compositeVAH = g_Days[dIdx].rows[upper].price + rowSize / 2.0;\
   g_Days[dIdx].compositeVAL = g_Days[dIdx].rows[lower].price - rowSize / 2.0;\
   for(int s = 0; s < 3; s++)\
   \{\
      if(g_Days[dIdx].sessions[s].totalVol == 0) continue;\
      double sMax = 0; int sPocR = 0;\
      for(int r = 0; r < nRows; r++)\
      \{ double sv = (s==0)?g_Days[dIdx].rows[r].asiaVol:(s==1)?g_Days[dIdx].rows[r].londonVol:g_Days[dIdx].rows[r].nyVol; if(sv > sMax) \{ sMax = sv; sPocR = r; \} \}\
      g_Days[dIdx].sessions[s].pocPrice = g_Days[dIdx].rows[sPocR].price;\
      double sTarget = g_Days[dIdx].sessions[s].totalVol * (InpVA_Percent / 100.0);\
      double sAccum = sMax; int sUp = sPocR, sDn = sPocR;\
      while(sAccum < sTarget)\
      \{\
         double vU=0,vD=0;\
         if(sUp+1<nRows)\{if(s==0)vU=g_Days[dIdx].rows[sUp+1].asiaVol;if(s==1)vU=g_Days[dIdx].rows[sUp+1].londonVol;if(s==2)vU=g_Days[dIdx].rows[sUp+1].nyVol;\}\
         if(sDn-1>=0)\{if(s==0)vD=g_Days[dIdx].rows[sDn-1].asiaVol;if(s==1)vD=g_Days[dIdx].rows[sDn-1].londonVol;if(s==2)vD=g_Days[dIdx].rows[sDn-1].nyVol;\}\
         if(vU==0&&vD==0) break;\
         if(vU>=vD)\{sUp++;sAccum+=vU;\}else\{sDn--;sAccum+=vD;\}\
      \}\
      g_Days[dIdx].sessions[s].vahPrice = g_Days[dIdx].rows[sUp].price + rowSize/2.0;\
      g_Days[dIdx].sessions[s].valPrice = g_Days[dIdx].rows[sDn].price - rowSize/2.0;\
   \}\
\}\
