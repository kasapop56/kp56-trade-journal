void CheckProximityAlerts(double price, datetime now)\
\{\
   static datetime lastProxTime=0;\
   if(now-lastProxTime<60) return;\
   double proxDist=InpAlert_Proximity_Pts*g_Pt;\
   for(int i=0;i<g_OB_Count;i++)\
   \{\
      if(g_OB[i].status==OB_MITIGATED||g_OB[i].clusterHidden) continue;\
      if(g_OB[i].proximityAlerted) continue;\
      if((int)g_OB[i].cfTier>(int)InpProximity_MinTier) continue;\
      if(price>=g_OB[i].low&&price<=g_OB[i].high) continue;\
      double distToZone=0;\
      if(g_OB[i].type==OB_BULLISH) distToZone=g_OB[i].high-price;\
      else distToZone=price-g_OB[i].low;\
      if(distToZone<=0||distToZone>proxDist) continue;\
      string tierStr=OB_TierStr(g_OB[i].cfTier);\
      string priTag=EnumToString(InpOB_Timeframe);StringReplace(priTag,"PERIOD_","");\
      string dir=(g_OB[i].type==OB_BULLISH)?"DEMAND":"SUPPLY";\
      int distPts=(int)MathRound(distToZone/g_Pt);\
      string htfInfo=(g_OB[i].cfHTF_Locked>0)?" "+g_OB[i].cfHTF_DetailLocked:"";\
      string msg=StringFormat("APPROACHING %s [%s:%d]%s\\n%s zone %.2f - %.2f\\nDistance: %d pts\\n%s\\n%s",dir,tierStr,g_OB[i].cfScore,htfInfo,(g_OB[i].structType==STRUCT_BOS?"BOS":"CHoCH"),g_OB[i].low,g_OB[i].high,distPts,TG_SafeStr(g_OB[i].cfDetail),_Symbol);\
