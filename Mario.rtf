   double hH[],hL[],hO[],hC[]; datetime hT[];\
   OB_ExtractArrays(htf, copied, hH, hL, hO, hC, hT);\
   OB_TryDetectSwing(InpSwingStrength, hH, hL, hT, copied, g_SwH, g_SwL, InpSwingStrength);\
   if(copied > 1)\
      OB_CheckBreaksAtBar(1, hH, hL, hO, hC, hT, copied, true,\
