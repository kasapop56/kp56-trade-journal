\
int GetEMABias(int handle, ENUM_TIMEFRAMES tf)\
\{\
   if(handle == INVALID_HANDLE) return 0;\
   double buf[];\
   ArraySetAsSeries(buf, true);\
   if(CopyBuffer(handle, 0, 1, 1, buf) <= 0) return 0;  // bar[1] = closed bar\
   double ema = buf[0];\
   if(ema <= 0) return 0;\
   double price = iClose(_Symbol, tf, 1);               // bar[1] = closed bar\
   if(price <= 0) return 0;\
   double threshold = InpEMA_Threshold_Pts * _Point;\
   if(price > ema + threshold) return  1;\
   if(price < ema - threshold) return -1;\
   return 0;\
\}\
\
int GetOBContext()\
\{\
   int bullCount = 0, bearCount = 0;\
   for(int i = 0; i < g_OB_Count; i++)\
   \{\
      if(g_OB[i].status == OB_MITIGATED || g_OB[i].clusterHidden) continue;\
      if(g_OB[i].cfTier == TIER_3) continue;\
      if(g_OB[i].type == OB_BULLISH) bullCount++;\
      else                           bearCount++;\
   \}\
   if(bullCount > bearCount) return  1;\
   if(bearCount > bullCount) return -1;\
   return 0;\
\}\
\
// \uc0\u9556 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9559 \
// \uc0\u9553           PHASE 2 \'97 CONFLUENCE DECISION ENGINE                     \u9553 \
// \uc0\u9562 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9565 \
\
void CF_Update(double price, datetime now)\
\{\
   if(!InpCF_Enabled) return;\
   bool htfValid = InpHTF_Enabled &&\
                   PeriodSeconds(InpHTF_Confirm_TF) > PeriodSeconds(InpOB_Timeframe);\
   g_BigBias   = htfValid ? GetEMABias(g_EMA_Handle_HTF, InpHTF_Confirm_TF)\
                       : GetEMABias(g_EMA_Handle_M5,  InpOB_Timeframe);\
   g_LocalBias = GetEMABias(g_EMA_Handle_M5, InpOB_Timeframe);\
   int obCtx   = GetOBContext();\
   double tmaDir   = GlobalVariableCheck("CONF_TMA_DIR")   ? GlobalVariableGet("CONF_TMA_DIR")   : 0.0;\
   double tmaTime  = GlobalVariableCheck("CONF_TMA_TIME")  ? GlobalVariableGet("CONF_TMA_TIME")  : 0.0;\
   double tmaPa    = GlobalVariableCheck("CONF_TMA_PA")    ? GlobalVariableGet("CONF_TMA_PA")    : 0.0;\
   double babyDir  = GlobalVariableCheck("CONF_BABY_DIR")  ? GlobalVariableGet("CONF_BABY_DIR")  : 0.0;\
   double babyTime = GlobalVariableCheck("CONF_BABY_TIME") ? GlobalVariableGet("CONF_BABY_TIME") : 0.0;\
   double babyType = GlobalVariableCheck("CONF_BABY_TYPE") ? GlobalVariableGet("CONF_BABY_TYPE") : 0.0;\
   int bias = g_BigBias;\
   string bigStr   = (g_BigBias   >  0) ? "BULL" : (g_BigBias   < 0 ? "BEAR" : "NEUT");\
   string localStr = (g_LocalBias >  0) ? "BULL" : (g_LocalBias < 0 ? "BEAR" : "NEUT");\
   string tfBigStr = htfValid ? EnumToString(InpHTF_Confirm_TF) : EnumToString(InpOB_Timeframe);\
   StringReplace(tfBigStr, "PERIOD_", "");\
   string ctxTag = "";\
   if(g_BigBias != 0 && g_LocalBias != 0 && g_BigBias != g_LocalBias) ctxTag = " X";\
   obCtx = GetOBContext();\
   string obTag = "";\
   if(obCtx != 0 && obCtx != g_BigBias) obTag = (obCtx > 0) ? " [OB:Bull]" : " [OB:Bear]";\
   g_cf_BiasStr = StringFormat("%s(%s) | %s(M5)%s%s", bigStr, tfBigStr, localStr, ctxTag, obTag);\
   if(g_DayCount > 0)\
   \{\
      int d = g_DayCount - 1;\
      double poc    = g_Days[d].compositePOC;\
      double vah    = g_Days[d].compositeVAH;\
      double val    = g_Days[d].compositeVAL;\
      double rowPts = InpRowSize_Points * g_Pt * 2.0;\
      if(poc > 0)\
      \{\
         if(price > vah)                        g_cf_SVPStr = StringFormat("Above VAH (%.2f)", vah);\
         else if(price < val)                   g_cf_SVPStr = StringFormat("Below VAL (%.2f)", val);\
         else if(MathAbs(price - poc) < rowPts) g_cf_SVPStr = StringFormat("At POC (%.2f)", poc);\
         else if(price > poc)                   g_cf_SVPStr = StringFormat("Upper VA / POC %.2f", poc);\
         else                                   g_cf_SVPStr = StringFormat("Lower VA / POC %.2f", poc);\
      \}\
      else g_cf_SVPStr = "No SVP data";\
   \}\
   else g_cf_SVPStr = "No SVP data";\
   if(bias == 0)\
   \{\
      g_cfDecision = CF_SKIP;\
      g_cf_DecStr  = "SKIP - No structural bias";\
      g_cf_ZoneStr = "-"; g_cf_TMAStr = "-";\
      g_cf_BabyStr = "-";\
      return;\
   \}\
   double proxDist   = InpAlert_Proximity_Pts * g_Pt;\
   bool   zoneFound  = false;\
   bool   zoneStrong = false;\
   bool   inOppZone  = false;\
   int    bestIdx    = -1;\
   double bestDist   = DBL_MAX;\
   for(int i = 0; i < g_OB_Count; i++)\
   \{\
      if(g_OB[i].status == OB_MITIGATED || g_OB[i].clusterHidden) continue;\
      if(bias > 0 && g_OB[i].type == OB_BEARISH && price >= g_OB[i].low && price <= g_OB[i].high) inOppZone = true;\
      if(bias < 0 && g_OB[i].type == OB_BULLISH && price >= g_OB[i].low && price <= g_OB[i].high) inOppZone = true;\
      if(bias > 0 && g_OB[i].type != OB_BULLISH) continue;\
      if(bias < 0 && g_OB[i].type != OB_BEARISH) continue;\
      double zH = g_OB[i].high, zL = g_OB[i].low;\
      double dist;\
      if(price >= zL && price <= zH)  dist = 0.0;\
      else if(bias > 0)               dist = MathMax(0.0, price - zH);\
      else                            dist = MathMax(0.0, zL - price);\
      if(dist > proxDist) continue;\
      if(dist < bestDist) \{ bestDist = dist; bestIdx = i; zoneFound = true; \}\
   \}\
   if(zoneFound && bestIdx >= 0)\
   \{\
      zoneStrong = (g_OB[bestIdx].cfTier == TIER_S || g_OB[bestIdx].cfTier == TIER_1);\
      string tierStr = OB_TierStr(g_OB[bestIdx].cfTier);\
      string dirStr  = (g_OB[bestIdx].type == OB_BULLISH) ? "Demand" : "Supply";\
      g_cf_ZoneStr = StringFormat("%s [%s:%d] @ %.2f-%.2f",\
                                  dirStr, tierStr, g_OB[bestIdx].cfScore,\
                                  g_OB[bestIdx].low, g_OB[bestIdx].high);\
   \}\
   else g_cf_ZoneStr = inOppZone ? "In opposite zone" : "No zone nearby";\
   long maxAge = (long)InpCF_SignalMaxBars * (long)PeriodSeconds(PERIOD_M5);\
   bool tmaValid   = false;\
   bool tmaAligned = false;\
   if(tmaDir != 0.0 && tmaTime > 0.0)\
   \{\
      long age   = (long)(now - (datetime)(long)tmaTime);\
      tmaValid   = (age >= 0 && age <= maxAge);\
      tmaAligned = tmaValid && ((bias > 0 && tmaDir > 0.0) || (bias < 0 && tmaDir < 0.0));\
   \}\
   if(tmaValid)\
   \{\
      string paStr  = (tmaPa >= 2.0) ? "PinBar" : "PA";\
      string dirLbl = (tmaDir > 0.0) ? "BUY" : "SELL";\
      string ctxLbl = tmaAligned ? "" : " (reversal)";\
      g_cf_TMAStr = StringFormat("%s %s%s", dirLbl, paStr, ctxLbl);\
   \}\
   else g_cf_TMAStr = "No signal";\
   bool babyValid   = false;\
   bool babyAligned = false;\
   bool babyAgainst = false;\
   if(babyDir != 0.0 && babyTime > 0.0)\
   \{\
      long age    = (long)(now - (datetime)(long)babyTime);\
      babyValid   = (age >= 0 && age <= maxAge);\
      babyAligned = babyValid && ((bias > 0 && babyDir > 0.0) || (bias < 0 && babyDir < 0.0));\
      babyAgainst = babyValid && !babyAligned;\
   \}\
   if(babyAligned)\
   \{\
      string typeStr = (babyType >= 2.0) ? "confirm 3 bars" : "warning 2 bars";\
      g_cf_BabyStr = StringFormat("%s %s", (babyDir > 0.0 ? "BUY" : "SELL"), typeStr);\
   \}\
   else if(babyAgainst)\
      g_cf_BabyStr = StringFormat("%s - Against Trend", (babyDir > 0.0 ? "BUY" : "SELL"));\
   else\
      g_cf_BabyStr = "No signal";\
   bool hasSignal = (tmaValid || babyValid);\
   g_cf_WarnStr = "";\
   if(!hasSignal)\
   \{\
      g_cfDecision = CF_WAIT;\
      g_cf_DecStr  = zoneFound ? "WAIT - Zone ready, no signal" : "WAIT - No signal";\
   \}\
   else\
   \{\
      string reasons = "";\
      if(!zoneFound && !inOppZone)  reasons += (StringLen(reasons) > 0 ? " | " : "") + "No zone";\
      if(inOppZone)                 reasons += (StringLen(reasons) > 0 ? " | " : "") + "In Opp Zone";\
      if(zoneFound && !zoneStrong)  reasons += (StringLen(reasons) > 0 ? " | " : "") + "Zone T2/T3";\
      if(babyAgainst)               reasons += (StringLen(reasons) > 0 ? " | " : "") + "Baby - Against Trend";\
      if(g_BigBias != 0 && g_LocalBias != 0 && g_BigBias != g_LocalBias)\
         reasons += (StringLen(reasons) > 0 ? " | " : "") + "Against Trend";\
      g_cf_WarnStr = reasons;\
      if(StringLen(reasons) == 0)\
      \{\
         g_cfDecision = CF_GO;\
         g_cf_DecStr  = (bias > 0) ? "GO - BUY" : "GO - SELL";\
      \}\
      else\
      \{\
         g_cfDecision = CF_WARN;\
         g_cf_DecStr  = ((bias > 0) ? "WARN - BUY " : "WARN - SELL ") + reasons;\
      \}\
   \}\
   datetime lastSigTime = 0;\
   if(tmaValid  && (datetime)(long)tmaTime  > lastSigTime) lastSigTime = (datetime)(long)tmaTime;\
   if(babyValid && (datetime)(long)babyTime > lastSigTime) lastSigTime = (datetime)(long)babyTime;\
   double fix6_tmaEntry  = (tmaValid  && GlobalVariableCheck("CONF_TMA_ENTRY"))  ? GlobalVariableGet("CONF_TMA_ENTRY")  : 0.0;\
   double fix6_babyEntry = (babyValid && GlobalVariableCheck("CONF_BABY_ENTRY")) ? GlobalVariableGet("CONF_BABY_ENTRY") : 0.0;\
   double fix6_useEntry  = (fix6_tmaEntry > 0.0) ? fix6_tmaEntry : fix6_babyEntry;\
   bool entryChanged = (fix6_useEntry == 0.0)\
                       || (MathAbs(fix6_useEntry - g_cfLastAlertEntry) > g_Pt);\
   bool shouldAlert = hasSignal\
                      && (g_cfDecision == CF_GO || (g_cfDecision == CF_WARN && !InpCF_TG_GO_Only))\
                      && InpTG_Enabled\
                      && lastSigTime > 0\
                      && lastSigTime != g_cfLastAlertSigTime\
                      && entryChanged;\
   if(shouldAlert)\
   \{\
      g_cfLastAlertSigTime = lastSigTime;\
      g_cfLastAlertEntry   = fix6_useEntry;\
      CF_SendAlert(price, bestIdx, g_cfDecision, tmaValid, babyValid);\
   \}\
\}\
\
void CF_SendAlert(double price, int zoneIdx, ENUM_CF_DECISION dec, bool tmaValid, bool babyValid)\
\{\
   long alertNum = 1;\
   if(GlobalVariableCheck("MARIO_CF_ALERT_NUM"))\
      alertNum = (long)GlobalVariableGet("MARIO_CF_ALERT_NUM") + 1;\
   GlobalVariableSet("MARIO_CF_ALERT_NUM", (double)alertNum);\
   string dash14 = "";\
   for(int k = 0; k < 14; k++) dash14 += ShortToString(0x2500);\
   string sep = "\\n" + dash14;\
   string s_warn       = ShortToString(0x26A0);\
   string emoji_green  = ShortToString(0xD83D) + ShortToString(0xDFE2);\
   string emoji_red    = ShortToString(0xD83D) + ShortToString(0xDD34);\
   string emoji_yellow = ShortToString(0xD83D) + ShortToString(0xDFE1);\
   bool   isBull   = (g_BigBias > 0);\
   string trendLbl = isBull ? "Bullish Trend" : "Bearish Trend";\
   string emoji, decLabel;\
   if(dec == CF_GO)\
   \{ emoji = isBull ? emoji_green : emoji_red; decLabel = "CONF"; \}\
   else\
   \{ emoji = isBull ? emoji_yellow : emoji_red; decLabel = "WARN"; \}\
   string headline = emoji + " " + decLabel + " - " + trendLbl;\
   string warnLine = "";\
   if(dec == CF_WARN && StringLen(g_cf_WarnStr) > 0)\
      warnLine = "\\n" + s_warn + " " + g_cf_WarnStr;\
   string bigLabel   = (g_BigBias   >  0) ? "BULL" : (g_BigBias   < 0 ? "BEAR" : "NEUT");\
   string localLabel = (g_LocalBias >  0) ? "BULL" : (g_LocalBias < 0 ? "BEAR" : "NEUT");\
   bool   htfV  = InpHTF_Enabled && PeriodSeconds(InpHTF_Confirm_TF) > PeriodSeconds(InpOB_Timeframe);\
   string tfLbl = htfV ? EnumToString(InpHTF_Confirm_TF) : EnumToString(InpOB_Timeframe);\
   StringReplace(tfLbl, "PERIOD_", "");\
   string biasStr = StringFormat("%s(%s) | %s(M5)", bigLabel, tfLbl, localLabel);\
   string zoneStr = "-";\
   if(zoneIdx >= 0 && zoneIdx < g_OB_Count)\
   \{\
      string tierStr = OB_TierStr(g_OB[zoneIdx].cfTier);\
      string dirStr  = (g_OB[zoneIdx].type == OB_BULLISH) ? "Demand" : "Supply";\
      zoneStr = StringFormat("%s [%s:%d] %.2f-%.2f",\
                             dirStr, tierStr, g_OB[zoneIdx].cfScore,\
                             g_OB[zoneIdx].low, g_OB[zoneIdx].high);\
   \}\
   double tmaEntry  = (tmaValid  && GlobalVariableCheck("CONF_TMA_ENTRY"))  ? GlobalVariableGet("CONF_TMA_ENTRY")  : 0.0;\
   double tmaTP     = (tmaValid  && GlobalVariableCheck("CONF_TMA_TP"))     ? GlobalVariableGet("CONF_TMA_TP")     : 0.0;\
   double tmaSL     = (tmaValid  && GlobalVariableCheck("CONF_TMA_SL"))     ? GlobalVariableGet("CONF_TMA_SL")     : 0.0;\
   double babyEntry = (babyValid && GlobalVariableCheck("CONF_BABY_ENTRY")) ? GlobalVariableGet("CONF_BABY_ENTRY") : 0.0;\
   double babyTP    = (babyValid && GlobalVariableCheck("CONF_BABY_TP"))    ? GlobalVariableGet("CONF_BABY_TP")    : 0.0;\
   double babySL    = (babyValid && GlobalVariableCheck("CONF_BABY_SL"))    ? GlobalVariableGet("CONF_BABY_SL")    : 0.0;\
   double useEntry = 0.0, useTP = 0.0, useSL = 0.0;\
   if(tmaEntry > 0.0)       \{ useEntry = tmaEntry;  useTP = tmaTP;  useSL = tmaSL;  \}\
   else if(babyEntry > 0.0) \{ useEntry = babyEntry; useTP = babyTP; useSL = babySL; \}\
   string etpsl;\
   if(useEntry > 0.0)\
      etpsl = StringFormat("%s\\nEntry: %.2f\\nTP:    %.2f\\nSL:    %.2f%s",\
                           sep, useEntry, useTP, useSL, sep);\
   else etpsl = sep;\
   string screenshotTag = (dec == CF_GO) ? "[SCREENSHOT:GO|CONF]\\n" : "";\
   string msg = StringFormat(\
      "CONF %s #%d\\n%s%s%s\\nBias:  %s\\nSVP:   %s\\nZone:  %s\\nTMA:   %s\\nBaby:  %s",\
      _Symbol, alertNum,\
      headline, warnLine, etpsl,\
      biasStr, g_cf_SVPStr, zoneStr,\
      g_cf_TMAStr, g_cf_BabyStr);\
   SendToTGQueue(screenshotTag + msg);\
\}\
