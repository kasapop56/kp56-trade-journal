void OB_CheckMitigationGeneric(int barIdx, const double &high[], const double &low[], const double &close[], const datetime &time[], SOB_Zone &obArr[], int &obCount)\
\{\
   for(int i=0;i<obCount;i++)\
   \{\
      if(obArr[i].status==OB_MITIGATED) continue;\
      if(obArr[i].breakTime>=time[barIdx]) continue;\
      double zH=obArr[i].high,zL=obArr[i].low;\
      bool fullMit=false;\
      if(obArr[i].type==OB_BULLISH&&close[barIdx]<zL) fullMit=true;\
      if(obArr[i].type==OB_BEARISH&&close[barIdx]>zH) fullMit=true;\
      if(fullMit) \{ obArr[i].status=OB_MITIGATED; obArr[i].touchCount++; obArr[i].lastTouchTime=time[barIdx]; obArr[i].isCurrentlyInside=false; continue; \}\
      bool entered=(low[barIdx]<=zH&&high[barIdx]>=zL);\
      if(!entered) \{ obArr[i].isCurrentlyInside=false; continue; \}\
      if(time[barIdx]!=obArr[i].lastTouchTime) \{ obArr[i].lastTouchTime=time[barIdx]; if(!obArr[i].isCurrentlyInside)\{obArr[i].touchCount++;obArr[i].status=OB_TESTED_1;\} \}\
      obArr[i].isCurrentlyInside=true;\
   \}\
\}\
\
void OB_RemoveOldestGeneric(SOB_Zone &obArr[], int &obCount)\
\{\
   if(obCount == 0) return;\
   int oldest = 0;\
   for(int i = 1; i < obCount; i++)\
      if(obArr[i].id < obArr[oldest].id) oldest = i;\
   // v5.61: Log dropped OB\
   if(InpML_Logger) ML_OnDeath(obArr[oldest], "DROPPED", iClose(_Symbol, PERIOD_CURRENT, 0));\
   for(int i = oldest; i < obCount - 1; i++)\
      obArr[i] = obArr[i + 1];\
   obCount--;\
   ArrayResize(obArr, obCount);\
\}\
