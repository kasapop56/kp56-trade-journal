      else if(g_OB[i].type==OB_BULLISH&&zMid<price)\{demandIdx[demandN]=i;demandDist[demandN]=dist;demandN++;\}\
   \}\
   RPT_SortByDist(supplyIdx,supplyDist,supplyN);RPT_SortByDist(demandIdx,demandDist,demandN);\
   rpt+="<b>SUPPLY (above)</b>\\n";if(supplyN==0)rpt+="  none\\n";\
   int showS=MathMin(supplyN,InpReport_MaxZones);for(int k=0;k<showS;k++)rpt+=RPT_FormatZone(g_OB[supplyIdx[k]],price);\
   rpt+="<b>DEMAND (below)</b>\\n";if(demandN==0)rpt+="  none\\n";\
   int showD=MathMin(demandN,InpReport_MaxZones);for(int k=0;k<showD;k++)rpt+=RPT_FormatZone(g_OB[demandIdx[k]],price);\
   if(InpReport_Plan)\{rpt+="-----------------\\n";rpt+=RPT_BuildPlan(price,supplyIdx,supplyDist,supplyN,demandIdx,demandDist,demandN);\}\
   return rpt;\
\}\
\
string RPT_FormatZone(SOB_Zone &ob, double price)\
\{\
   string tierStr=OB_TierStr(ob.cfTier),sType=(ob.structType==STRUCT_BOS)?"BOS":"CHoCH";\
   string htfStr=(ob.cfHTF_Locked>0)?" "+ob.cfHTF_DetailLocked:"";\
   string freshStr=(ob.status==OB_FRESH)?"Fresh":"Tested";\
   double nearEdge=(ob.type==OB_BULLISH)?ob.high:ob.low;\
   int distPts=(int)MathRound(MathAbs(price-nearEdge)/g_Pt);\
   return StringFormat("  [%s:%d]%s %s %s %.2f-%.2f (%d pts) %s\\n    %s\\n",tierStr,ob.cfScore,htfStr,freshStr,sType,ob.low,ob.high,distPts,_Symbol,TG_SafeStr(ob.cfDetail));\
\}\
\
string RPT_BuildPlan(double price, int &sIdx[], double &sDist[], int sN, int &dIdx[], double &dDist[], int dN)\
\{\
   string plan="<b>PLAN:</b>\\n";\
   if(sN>0)\{int si=sIdx[0];int distPts=(int)MathRound(MathAbs(price-g_OB[si].low)/g_Pt);string sTier=OB_TierStr(g_OB[si].cfTier);if(distPts<InpAlert_Proximity_Pts)plan+=StringFormat("  Supply %s [%d] only %d pts above!\\n",sTier,g_OB[si].cfScore,distPts);else plan+=StringFormat("  Nearest supply %s [%d] at %d pts\\n",sTier,g_OB[si].cfScore,distPts);\}\
   else plan+="  No supply zones above\\n";\
   if(dN>0)\{int di=dIdx[0];int distPts=(int)MathRound(MathAbs(price-g_OB[di].high)/g_Pt);string dTier=OB_TierStr(g_OB[di].cfTier);if(distPts<InpAlert_Proximity_Pts)plan+=StringFormat("  Demand %s [%d] only %d pts below!\\n",dTier,g_OB[di].cfScore,distPts);else plan+=StringFormat("  Nearest demand %s [%d] at %d pts\\n",dTier,g_OB[di].cfScore,distPts);\}\
   else plan+="  No demand zones below\\n";\
   if(sN>0&&dN>0)\{double ratio=(dDist[0]>0)?sDist[0]/dDist[0]:99;if(ratio>2.0)plan+="  Bias: Near DEMAND - watch for bounce\\n";else if(ratio<0.5)plan+="  Bias: Near SUPPLY - watch for rejection\\n";else plan+="  Bias: Mid-range - wait for directional move\\n";\}\
   if(InpReport_SVP_Context&&g_DayCount>0)\{int d=g_DayCount-1;double poc=g_Days[d].compositePOC,vah=g_Days[d].compositeVAH,val=g_Days[d].compositeVAL;if(price>vah)plan+="  Above VA - extended, mean-reversion risk\\n";else if(price<val)plan+="  Below VA - undervalued, bounce potential\\n";else if(poc>0&&MathAbs(price-poc)<InpRowSize_Points*g_Pt*3)plan+="  Near POC - fair value, expect range\\n";\}\
   if(sN>=2)\{double clusterRange=MathAbs(g_OB[sIdx[0]].poc-g_OB[sIdx[MathMin(sN-1,InpReport_MaxZones-1)]].poc);int clusterPts=(int)MathRound(clusterRange/g_Pt);if(clusterPts<500&&sN>=2)plan+=StringFormat("  Supply cluster: %d zones within %d pts\\n",MathMin(sN,InpReport_MaxZones),clusterPts);\}\
   if(dN>=2)\{double clusterRange=MathAbs(g_OB[dIdx[0]].poc-g_OB[dIdx[MathMin(dN-1,InpReport_MaxZones-1)]].poc);int clusterPts=(int)MathRound(clusterRange/g_Pt);if(clusterPts<500&&dN>=2)plan+=StringFormat("  Demand cluster: %d zones within %d pts\\n",MathMin(dN,InpReport_MaxZones),clusterPts);\}\
   return plan;\
\}\
\
void RPT_SortByDist(int &idx[], double &dist[], int n)\
\{\
   for(int i=0;i<n-1;i++)for(int j=i+1;j<n;j++)if(dist[j]<dist[i])\{double td=dist[i];dist[i]=dist[j];dist[j]=td;int ti=idx[i];idx[i]=idx[j];idx[j]=ti;\}\
\}\
