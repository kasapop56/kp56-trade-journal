int OnCalculate(const int rates_total, const int prev_calculated,\
                const datetime &time[], const double &open[],\
                const double &high[], const double &low[],\
                const double &close[], const long &tick_volume[],\
                const long &volume[], const int &spread[])\
\{\
   if(rates_total < 50) return(rates_total);\
\
   ArraySetAsSeries(time, true);\
   ArraySetAsSeries(open, true);\
   ArraySetAsSeries(high, true);\
   ArraySetAsSeries(low, true);\
   ArraySetAsSeries(close, true);\
\
   bool htfValid  = InpHTF_Enabled &&\
                    PeriodSeconds(InpHTF_Confirm_TF) > PeriodSeconds(InpOB_Timeframe);\
   bool htf2Valid = InpHTF2_Enabled &&\
                    PeriodSeconds(InpHTF2_TF) > PeriodSeconds(InpHTF_Confirm_TF);\
\
   //=== INITIAL FULL SCAN ===\
   bool needHTF2 = htf2Valid && !g_HTF2_Ready;\
   if(!g_SVP_Ready || !g_OB_Ready || (htfValid && !g_CF_Ready) || needHTF2)\
   \{\
      g_RetryCount++;\
\
      if(!g_SVP_Ready)\
      \{\
         SVP_FullRebuild();\
         if(g_DayCount > 0) \{ g_SVP_Ready = true; Print("SVP v3.0: Ready \'97 ", g_DayCount, " trading days loaded from M1"); \}\
         else if(g_RetryCount <= 3) Print("SVP v3.0: Waiting for M1 data... (attempt ", g_RetryCount, ")");\
      \}\
\
      if(!g_OB_Ready)\
      \{\
         bool dataLoaded = OB_FullScanHTF();\
         if(dataLoaded)\
         \{\
            g_OB_Ready = true;\
            OB_ClusterAnalysis();\
            OB_PostScanM1Mitigation();\
            Print("OB v3.0 PRIMARY: Ready \'97 ", g_OB_Count, " active zones on ", EnumToString(InpOB_Timeframe));\
         \}\
         else if(g_RetryCount <= 5) Print("OB v3.0: Waiting for ", EnumToString(InpOB_Timeframe), " data...");\
         else \{ g_OB_Ready = true; Print("OB v3.0: WARNING \'97 Could not load primary TF data."); \}\
      \}\
\
      if(htfValid && !g_CF_Ready)\
      \{\
         bool cfLoaded = CF_FullScan();\
         if(cfLoaded)\
         \{\
            g_CF_Ready = true;\
            Print("HTF1 CONFIRM: Ready \'97 ", g_CF_OB_Count, " shadow zones on ", EnumToString(InpHTF_Confirm_TF));\
         \}\
         else if(g_RetryCount <= 5) Print("HTF1 CONFIRM: Waiting for ", EnumToString(InpHTF_Confirm_TF), " data...");\
         else \{ g_CF_Ready = true; Print("HTF1 CONFIRM: WARNING \'97 Could not load data."); \}\
      \}\
\
      if(htf2Valid && !g_HTF2_Ready)\
      \{\
         bool htf2Loaded = HTF2_FullScan();\
         if(htf2Loaded)\
         \{\
            g_HTF2_Ready = true;\
            Print("HTF2 (H1): Ready \'97 ", g_HTF2_OB_Count, " zones on ", EnumToString(InpHTF2_TF));\
         \}\
         else if(g_RetryCount <= 5) Print("HTF2: Waiting for ", EnumToString(InpHTF2_TF), " data...");\
         else \{ g_HTF2_Ready = true; Print("HTF2: WARNING \'97 Could not load data."); \}\
      \}\
\
      bool allReady = g_SVP_Ready && g_OB_Ready &&\
                      (!htfValid  || g_CF_Ready) &&\
                      (!htf2Valid || g_HTF2_Ready);\
      if(allReady)\
      \{\
         ScoreAllOBs();\
         g_PrevBars            = rates_total;\
         g_HTF_LastBarTime     = iTime(_Symbol, InpOB_Timeframe, 0);\
         g_PeriodicRescanTime  = TimeCurrent();\
         if(htfValid)  g_CF_LastBarTime   = iTime(_Symbol, InpHTF_Confirm_TF, 0);\
         if(htf2Valid) g_HTF2_LastBarTime  = iTime(_Symbol, InpHTF2_TF, 0);\
         if(InpCF_Enabled) CF_Update(close[0], time[0]);\
         DrawAll(time[0]);\
\
         Print("Confluence v5.62: READY \'97 Primary=", g_OB_Count, " (", EnumToString(InpOB_Timeframe), ")",\
               " HTF1=", g_CF_OB_Count, " (", EnumToString(InpHTF_Confirm_TF), ")",\
               " HTF2=", g_HTF2_OB_Count, " (", EnumToString(InpHTF2_TF), ")",\
               " Days=", g_DayCount,\
               " | S:", g_stat_TierS, " T1:", g_stat_Tier1,\
               " T2:", g_stat_Tier2, " T3:", g_stat_Tier3,\
               " HTF_Conf:", g_stat_HTF_Confirmed,\
               " ML:", (InpML_Logger ? "ON" : "OFF"));\
      \}\
      return(rates_total);\
   \}\
\
   //=== NEW BAR UPDATE ===\
   if(g_PrevBars == rates_total) return(rates_total);\
   g_PrevBars = rates_total;\
\
   // v5.61: Update max bounce for all tracked OBs\
   if(InpML_Logger) ML_UpdateBounce(g_OB, g_OB_Count, high[0], low[0]);\
\
   SVP_FullRebuild();\
\
   datetime now = TimeCurrent();\
   bool didPeriodicRescan = false;\
\
   if(now - g_PeriodicRescanTime >= (datetime)PeriodSeconds(InpOB_Timeframe))\
   \{\
      g_PeriodicRescanTime = now;\
      OB_PeriodicRescan();\
      didPeriodicRescan = true;\
   \}\
\
   if(!didPeriodicRescan)\
   \{\
      datetime htfLastBar = iTime(_Symbol, InpOB_Timeframe, 0);\
      if(htfLastBar > g_HTF_LastBarTime && g_HTF_LastBarTime > 0)\
      \{\
         OB_IncrementalHTF();\
         g_HTF_LastBarTime = htfLastBar;\
      \}\
\
      if(htfValid)\
      \{\
         datetime cfLastBar = iTime(_Symbol, InpHTF_Confirm_TF, 0);\
         if(cfLastBar > g_CF_LastBarTime && g_CF_LastBarTime > 0)\
         \{\
            CF_Incremental();\
            g_CF_LastBarTime = cfLastBar;\
         \}\
         CF_CheckMitigationCurrent(high[0], low[0], close[0], time[0]);\
         CF_GarbageCollect();\
      \}\
\
      if(htf2Valid && g_HTF2_Ready)\
      \{\
         datetime htf2LastBar = iTime(_Symbol, InpHTF2_TF, 0);\
         if(htf2LastBar > g_HTF2_LastBarTime && g_HTF2_LastBarTime > 0)\
         \{\
            HTF2_Incremental();\
            g_HTF2_LastBarTime = htf2LastBar;\
         \}\
         HTF2_CheckMitigationCurrent(high[0], low[0], close[0], time[0]);\
         HTF2_GarbageCollect();\
      \}\
\
      OB_ClusterAnalysis();\
      ScoreAllOBs();\
   \}\
\
   if(InpMT5_Retest || (InpTG_Enabled && InpTG_Retest))\
      CheckConfluenceAlerts(close[0], time[0]);\
   if(InpMT5_Proximity || (InpTG_Enabled && InpTG_Proximity))\
      CheckProximityAlerts(close[0], time[0]);\
   if(InpMT5_Sweep || (InpTG_Enabled && InpTG_Sweep))\
      CheckSweepAlerts(high[0], low[0], close[0], open[0], time[0]);\
\
   if(InpReport_Freq != RPT_OFF)\
      CheckSituationReport(close[0], time[0]);\
\
   if(InpDebugPrint)\
   \{\
      Print("=== MIT_CHECK NewBar === OB_Count=", g_OB_Count,\
            " bar[0] T=", TimeToString(time[0]),\
            " H=", DoubleToString(high[0], 2),\
            " L=", DoubleToString(low[0], 2),\
            " C=", DoubleToString(close[0], 2));\
      if(rates_total > 1)\
         Print("=== MIT_CHECK bar[1] === T=", TimeToString(time[1]),\
               " H=", DoubleToString(high[1], 2),\
               " L=", DoubleToString(low[1], 2),\
               " C=", DoubleToString(close[1], 2));\
   \}\
\
   if(rates_total > 1)\
      OB_CheckMitigationCurrent(high[1], low[1], close[1], time[1]);\
   OB_CheckMitigationCurrent(high[0], low[0], close[0], time[0]);\
   OB_GarbageCollect();\
\
   if(g_OB_Count == 0 && g_OB_Ready)\
   \{\
      datetime cooldown = (datetime)PeriodSeconds(InpOB_Timeframe);\
      if(now - g_LastRescanTime > cooldown)\
      \{\
         g_LastRescanTime = now;\
         if(InpDebugPrint) Print("RESCAN_TRIGGER: OB_Count=0 -> full rescan");\
         OB_PeriodicRescan();\
         return(rates_total);\
      \}\
   \}\
\
   if(!didPeriodicRescan)\
   \{\
      if(InpCF_Enabled) CF_Update(close[0], time[0]);\
      DrawAll(time[0]);\
   \}\
\
   return(rates_total);\
\}\
\
