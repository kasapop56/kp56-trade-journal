int OnInit()\
\{\
   g_Pt = _Point;\
\
   ArrayResize(g_OB, 0, InpMaxOB_Count + 10);\
   ArrayResize(g_SwH, 0, 200);\
   ArrayResize(g_SwL, 0, 200);\
\
   ArrayResize(g_CF_OB, 0, InpHTF_MaxOB + 10);\
   ArrayResize(g_CF_SwH, 0, 200);\
   ArrayResize(g_CF_SwL, 0, 200);\
\
   ArrayResize(g_HTF2_OB, 0, InpHTF2_MaxOB + 10);\
   ArrayResize(g_HTF2_SwH, 0, 200);\
   ArrayResize(g_HTF2_SwL, 0, 200);\
\
   ArrayResize(g_Days, 0, 5);\
\
   g_SVP_Ready = false; g_OB_Ready = false; g_CF_Ready = false;\
   g_HTF2_Ready = false;\
   g_RetryCount = 0;\
   g_PrevBars = 0;\
   g_HTF_LastBarTime = 0; g_CF_LastBarTime = 0; g_HTF2_LastBarTime = 0;\
   g_OB_Count = 0; g_OB_Id = 0; g_Trend = 0;\
   g_CF_OB_Count = 0; g_CF_OB_Id = 0; g_CF_Trend = 0;\
   g_HTF2_OB_Count = 0; g_HTF2_OB_Id = 0; g_HTF2_Trend = 0;\
   g_DayCount = 0;\
   g_Ghost_Count = 0;\
   ArrayResize(g_Ghost, 0, InpGhost_Max + 5);\
\
   g_RPT_LastHour = -1;\
   g_RPT_LastSession = SESSION_ASIA;\
   g_RPT_SessionInit = false;\
\
   g_LastRescanTime    = 0;\
   g_PeriodicRescanTime = 0;\
\
   g_cfDecision = CF_SKIP;\
   g_cfLastAlertSigTime = (datetime)(long)(GlobalVariableCheck("MARIO_CF_LAST_ALERT") ? GlobalVariableGet("MARIO_CF_LAST_ALERT") : 0.0);\
   g_cfLastAlertEntry   = GlobalVariableCheck("MARIO_CF_LAST_ENTRY") ? GlobalVariableGet("MARIO_CF_LAST_ENTRY") : 0.0;\
   g_cf_BiasStr = ""; g_cf_SVPStr  = ""; g_cf_ZoneStr = "";\
   g_cf_TMAStr  = ""; g_cf_BabyStr = ""; g_cf_DecStr  = "";\
   g_BigBias = 0; g_LocalBias = 0;\
\
   g_EMA_Handle_HTF = iMA(_Symbol, InpHTF_Confirm_TF, 150, 0, MODE_EMA, PRICE_CLOSE);\
   g_EMA_Handle_M5  = iMA(_Symbol, InpOB_Timeframe,   150, 0, MODE_EMA, PRICE_CLOSE);\
\
   if(InpHTF_Enabled && PeriodSeconds(InpHTF_Confirm_TF) <= PeriodSeconds(InpOB_Timeframe))\
      Print("WARNING: HTF1 TF (", EnumToString(InpHTF_Confirm_TF),\
            ") must be higher than Primary TF (", EnumToString(InpOB_Timeframe), "). HTF1 disabled.");\
\
   if(InpHTF2_Enabled)\
   \{\
      int minRef = InpHTF_Enabled ? PeriodSeconds(InpHTF_Confirm_TF) : PeriodSeconds(InpOB_Timeframe);\
      if(PeriodSeconds(InpHTF2_TF) <= minRef)\
         Print("WARNING: HTF2 TF (", EnumToString(InpHTF2_TF),\
               ") must be higher than HTF1 (", EnumToString(InpHTF_Confirm_TF), "). HTF2 may not function correctly.");\
   \}\
\
   string htf1Str = InpHTF_Enabled  ? EnumToString(InpHTF_Confirm_TF) : "OFF";\
   string htf2Str = InpHTF2_Enabled ? EnumToString(InpHTF2_TF)        : "OFF";\
   StringReplace(htf1Str, "PERIOD_", "");\
   StringReplace(htf2Str, "PERIOD_", "");\
   IndicatorSetString(INDICATOR_SHORTNAME,\
      StringFormat("OB+SVP v5.62 [OB:%s HTF:%s H1:%s SVP:M1]",\
         EnumToString(InpOB_Timeframe), htf1Str, htf2Str));\
\
   // v5.61: ML Logger init\
   if(InpML_Logger) ML_InitCSV();\
\
   return(INIT_SUCCEEDED);\
\}\
