void OB_CheckMitigationCurrent(double barHigh, double barLow, double barClose, datetime barTime)\
\{\
   for(int i=0;i<g_OB_Count;i++)\
   \{\
      if(g_OB[i].status==OB_MITIGATED) continue;\
