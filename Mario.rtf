            string msg=StringFormat("MITIGATED [%s:%d]%s\\n%s OB (%s) DESTROYED\\nZone: %.2f - %.2f\\nClose: %.2f | Was: %s\\nTouches: %d\\n%s\\n%s",tierStr,g_OB[i].cfScore,htfInfo,dir,priTag,zL,zH,barClose,prevStatus,g_OB[i].touchCount,TG_SafeStr(g_OB[i].cfDetail),_Symbol);\
            if(InpMT5_Mitigated)\{Alert("MITIGATED "+msg);if(InpMT5_Push)SendNotification("MITIGATED "+msg);\}\
            if(InpTG_Enabled&&InpTG_Mitigated)\{if(InpTG_TierS_Only&&g_OB[i].cfTier!=TIER_S)\{\}else SendToTGQueue("MITIGATED\\n"+msg);\}\
         \}\
         continue;\
      \}\
      bool entered=(barLow<=zH&&barHigh>=zL);\
      if(!entered)\{g_OB[i].isCurrentlyInside=false;continue;\}\
       if(barTime!=g_OB[i].lastTouchTime)\{g_OB[i].lastTouchTime=barTime;if(!g_OB[i].isCurrentlyInside)\{if(g_OB[i].touchCount==0&&g_OB[i].mlFirstTouchTime==0)g_OB[i].mlFirstTouchTime=barTime;g_OB[i].touchCount++;g_OB[i].status=OB_TESTED_1;\}\}\
      g_OB[i].isCurrentlyInside=true;\
   \}\
