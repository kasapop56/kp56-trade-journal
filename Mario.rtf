void DrawAll(datetime now)\
\{\
   ObjectsDeleteAll(0,"SVP_");\
   for(int d=0;d<g_DayCount;d++)\{if(g_Days[d].isToday)SVP_DrawTodayProfile(d,now);else if(InpShowPrevDay)SVP_DrawPrevDayLevels(d,now);\}\
   for(int i=0;i<g_OB_Count;i++)\{if(g_OB[i].clusterHidden)\{OB_DeleteObj(g_OB[i].id);continue;\}DrawOB_Confluence(g_OB[i],now);\}\
   if(InpGhost_Enabled)\{for(int i=0;i<g_Ghost_Count;i++)DrawGhostZone(g_Ghost[i],now);\}\
   if(InpHTF2_Enabled && InpHTF2_ShowZones && g_HTF2_Ready) DrawHTF2_Zones(now);\
   if(InpShowDashboard) DrawDashboard();\
   ChartRedraw(0);\
\}\
\
void DrawHTF2_Zones(datetime now)\
\{\
   double buffer = InpHTF2_HideBuffer_Pts * g_Pt;\
   for(int i = 0; i < g_HTF2_OB_Count; i++)\
   \{\
      if(g_HTF2_OB[i].status == OB_MITIGATED) continue;\
      double h2H = g_HTF2_OB[i].high;\
      double h2L = g_HTF2_OB[i].low;\
      bool hasM5Overlap = false;\
      for(int j = 0; j < g_OB_Count; j++)\
      \{\
         if(g_OB[j].status == OB_MITIGATED || g_OB[j].clusterHidden) continue;\
         if((g_OB[j].low - buffer) <= h2H && (g_OB[j].high + buffer) >= h2L)\
         \{ hasM5Overlap = true; break; \}\
      \}\
      if(hasM5Overlap)\
      \{\
         ObjectDelete(0, "H2_R_" + IntegerToString(g_HTF2_OB[i].id));\
         ObjectDelete(0, "H2_L_" + IntegerToString(g_HTF2_OB[i].id));\
         continue;\
      \}\
      DrawHTF2_Zone(g_HTF2_OB[i], now);\
   \}\
\}\
