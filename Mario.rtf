bool GetOBZone(int index, SOB_Zone &zone)\
\{ if(index<0||index>=g_OB_Count)return false;zone=g_OB[index];return true; \}\
\
double GetTodayPOC() \{ return (g_DayCount>0)?g_Days[g_DayCount-1].compositePOC:0; \}\
double GetTodayVAH() \{ return (g_DayCount>0)?g_Days[g_DayCount-1].compositeVAH:0; \}\
double GetTodayVAL() \{ return (g_DayCount>0)?g_Days[g_DayCount-1].compositeVAL:0; \}\
\
bool IsInValueArea(double price)\
\{\
   if(g_DayCount==0) return false;\
   int d=g_DayCount-1;\
   return (price>=g_Days[d].compositeVAL&&price<=g_Days[d].compositeVAH);\
\}\
