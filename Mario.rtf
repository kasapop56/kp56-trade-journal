// \uc0\u9556 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9559 \
// \uc0\u9553           v5.54 \'97 PERIODIC FULL RESCAN                            \u9553 \
// \uc0\u9553           v5.60 FIX 2: HTF2 touch state preserved across rescan  \u9553 \
// \uc0\u9562 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9565 \
\
void OB_PeriodicRescan()\
\{\
   SOB_Zone savedZones[];\
   int savedCount = g_OB_Count;\
   ArrayResize(savedZones, savedCount);\
   for(int i = 0; i < savedCount; i++) savedZones[i] = g_OB[i];\
\
   bool dataLoaded = OB_FullScanHTF(true);\
   if(!dataLoaded)\
   \{\
      if(InpDebugPrint) Print("PERIODIC_RESCAN: primary data not ready, skip");\
      return;\
   \}\
\
   ObjectsDeleteAll(0, "OB_");\
   ObjectsDeleteAll(0, "GH_");\
\
   bool htfValid  = InpHTF_Enabled &&\
                    PeriodSeconds(InpHTF_Confirm_TF) > PeriodSeconds(InpOB_Timeframe);\
   bool htf2Valid = InpHTF2_Enabled &&\
                    PeriodSeconds(InpHTF2_TF) > PeriodSeconds(InpHTF_Confirm_TF);\
\
   OB_PostScanM1Mitigation();\
\
   if(htfValid)\
   \{\
      CF_FullScan(true);\
      g_CF_LastBarTime = iTime(_Symbol, InpHTF_Confirm_TF, 0);\
   \}\
\
   SOB_Zone savedHTF2[];\
   int savedHTF2Count = 0;\
   if(htf2Valid && g_HTF2_Ready)\
   \{\
      savedHTF2Count = g_HTF2_OB_Count;\
      ArrayResize(savedHTF2, savedHTF2Count);\
      for(int i = 0; i < savedHTF2Count; i++) savedHTF2[i] = g_HTF2_OB[i];\
\
      ObjectsDeleteAll(0, "H2_");\
      HTF2_FullScan(true);\
      g_HTF2_LastBarTime = iTime(_Symbol, InpHTF2_TF, 0);\
\
      for(int i = 0; i < g_HTF2_OB_Count; i++)\
      \{\
         for(int j = 0; j < savedHTF2Count; j++)\
         \{\
            if(savedHTF2[j].timeStart != g_HTF2_OB[i].timeStart) continue;\
            if(savedHTF2[j].type      != g_HTF2_OB[i].type)      continue;\
            g_HTF2_OB[i].touchCount        = savedHTF2[j].touchCount;\
            g_HTF2_OB[i].lastTouchTime     = savedHTF2[j].lastTouchTime;\
            g_HTF2_OB[i].isCurrentlyInside = savedHTF2[j].isCurrentlyInside;\
            if(savedHTF2[j].status == OB_TESTED_1) g_HTF2_OB[i].status = OB_TESTED_1;\
            break;\
         \}\
      \}\
   \}\
\
   for(int i = 0; i < g_OB_Count; i++)\
   \{\
      datetime key    = g_OB[i].timeStart;\
      ENUM_OB_TYPE kt = g_OB[i].type;\
\
      for(int j = 0; j < savedCount; j++)\
      \{\
         if(savedZones[j].timeStart != key) continue;\
         if(savedZones[j].type      != kt)  continue;\
\
         g_OB[i].touchCount          = savedZones[j].touchCount;\
         g_OB[i].lastTouchTime       = savedZones[j].lastTouchTime;\
         g_OB[i].isCurrentlyInside   = savedZones[j].isCurrentlyInside;\
         g_OB[i].cfAlerted           = savedZones[j].cfAlerted;\
         g_OB[i].proximityAlerted    = savedZones[j].proximityAlerted;\
         g_OB[i].sweepAlerted        = savedZones[j].sweepAlerted;\
         g_OB[i].mitigatedAlerted    = savedZones[j].mitigatedAlerted;\
         g_OB[i].cfSVP_Locked        = savedZones[j].cfSVP_Locked;\
         g_OB[i].cfSVP_DetailLocked  = savedZones[j].cfSVP_DetailLocked;\
         g_OB[i].cfHTF_Locked        = savedZones[j].cfHTF_Locked;\
         g_OB[i].cfHTF_DetailLocked  = savedZones[j].cfHTF_DetailLocked;\
         // v5.61: Restore ML state across rescan\
         g_OB[i].mlMaxBounce         = savedZones[j].mlMaxBounce;\
         g_OB[i].mlPriceAtBirth      = savedZones[j].mlPriceAtBirth;\
         g_OB[i].mlEmaBig            = savedZones[j].mlEmaBig;\
         g_OB[i].mlEmaLocal          = savedZones[j].mlEmaLocal;\
         g_OB[i].mlSession           = savedZones[j].mlSession;\
         g_OB[i].mlPOC               = savedZones[j].mlPOC;\
         g_OB[i].mlVAH               = savedZones[j].mlVAH;\
         g_OB[i].mlVAL               = savedZones[j].mlVAL;\
         g_OB[i].mlPrevPOC           = savedZones[j].mlPrevPOC;\
         g_OB[i].mlDistToEMA         = savedZones[j].mlDistToEMA;\
