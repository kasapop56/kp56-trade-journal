void HTF2_CheckMitigationCurrent(double barHigh, double barLow, double barClose, datetime barTime)\
\{\
   if(!InpHTF2_Enabled) return;\
   for(int i = 0; i < g_HTF2_OB_Count; i++)\
   \{\
      if(g_HTF2_OB[i].status == OB_MITIGATED) continue;\
      datetime protectedUntil = g_HTF2_OB[i].breakTime + (datetime)PeriodSeconds(InpHTF2_TF);\
      if(protectedUntil > barTime) continue;\
      double zH=g_HTF2_OB[i].high, zL=g_HTF2_OB[i].low;\
      bool fullMit = false;\
      if(g_HTF2_OB[i].type==OB_BULLISH && barClose<zL) fullMit=true;\
      if(g_HTF2_OB[i].type==OB_BEARISH && barClose>zH) fullMit=true;\
      if(fullMit)\
      \{\
         g_HTF2_OB[i].status=OB_MITIGATED;\
         g_HTF2_OB[i].touchCount++;\
         g_HTF2_OB[i].lastTouchTime=barTime;\
         g_HTF2_OB[i].isCurrentlyInside=false;\
         ObjectDelete(0, "H2_R_" + IntegerToString(g_HTF2_OB[i].id));\
         ObjectDelete(0, "H2_L_" + IntegerToString(g_HTF2_OB[i].id));\
         continue;\
      \}\
      bool entered = (barLow <= zH && barHigh >= zL);\
      if(!entered) \{ g_HTF2_OB[i].isCurrentlyInside=false; continue; \}\
      if(barTime != g_HTF2_OB[i].lastTouchTime)\
      \{ g_HTF2_OB[i].lastTouchTime=barTime; if(!g_HTF2_OB[i].isCurrentlyInside) \{ g_HTF2_OB[i].touchCount++; g_HTF2_OB[i].status=OB_TESTED_1; \} \}\
      g_HTF2_OB[i].isCurrentlyInside=true;\
   \}\
\}\
