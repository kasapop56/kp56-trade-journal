void OB_ClusterAnalysis()\
\{\
   if(InpClusterDist_Pts<=0) return;\
   double clusterDist=InpClusterDist_Pts*g_Pt;\
   for(int i=0;i<g_OB_Count;i++)\{g_OB[i].clusterSize=1;g_OB[i].clusterHidden=false;\}\
   for(int i=0;i<g_OB_Count;i++)\
   \{\
      if(g_OB[i].status==OB_MITIGATED||g_OB[i].clusterHidden) continue;\
      for(int j=i+1;j<g_OB_Count;j++)\
      \{\
         if(g_OB[j].status==OB_MITIGATED||g_OB[j].clusterHidden) continue;\
         if(g_OB[i].type!=g_OB[j].type) continue;\
         double dist=MathAbs(g_OB[i].poc-g_OB[j].poc);\
         bool overlapping=(g_OB[i].low<=g_OB[j].high&&g_OB[i].high>=g_OB[j].low);\
         if(dist<=clusterDist||overlapping)\{int winner=OB_CompareStrength(i,j);int loser=(winner==i)?j:i;g_OB[winner].clusterSize+=g_OB[loser].clusterSize;g_OB[loser].clusterSize=0;g_OB[loser].clusterHidden=true;\}\
      \}\
   \}\
\}\
\
int OB_CompareStrength(int a, int b)\
\{\
   if(g_OB[a].structType==STRUCT_CHOCH&&g_OB[b].structType!=STRUCT_CHOCH) return a;\
   if(g_OB[b].structType==STRUCT_CHOCH&&g_OB[a].structType!=STRUCT_CHOCH) return b;\
   if(g_OB[a].hasFVG&&!g_OB[b].hasFVG) return a;\
   if(g_OB[b].hasFVG&&!g_OB[a].hasFVG) return b;\
   double sA=g_OB[a].high-g_OB[a].low,sB=g_OB[b].high-g_OB[b].low;\
   if(sA<sB) return a; if(sB<sA) return b;\
   return (g_OB[a].id>g_OB[b].id)?a:b;\
\}\
