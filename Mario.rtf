void DrawHTF2_Zone(SOB_Zone &ob, datetime now)\
\{\
   string rName = "H2_R_" + IntegerToString(ob.id);\
   string lName = "H2_L_" + IntegerToString(ob.id);\
   bool isBull  = (ob.type == OB_BULLISH);\
   color clr    = isBull ? InpHTF2_Bull_Color : InpHTF2_Bear_Color;\
   datetime endT = now + (datetime)((long)PeriodSeconds() * 30);\
   if(ObjectFind(0, rName) < 0)\
   \{\
      ObjectCreate(0, rName, OBJ_RECTANGLE, 0, ob.timeStart, ob.high, endT, ob.low);\
      ObjectSetInteger(0, rName, OBJPROP_COLOR, clr);\
      ObjectSetInteger(0, rName, OBJPROP_FILL, false);\
      ObjectSetInteger(0, rName, OBJPROP_BACK, true);\
      ObjectSetInteger(0, rName, OBJPROP_WIDTH, 2);\
      ObjectSetInteger(0, rName, OBJPROP_STYLE, STYLE_DASH);\
      ObjectSetInteger(0, rName, OBJPROP_SELECTABLE, false);\
      ObjectSetInteger(0, rName, OBJPROP_HIDDEN, true);\
   \}\
   else\
   \{\
      ObjectSetInteger(0, rName, OBJPROP_TIME,  0, ob.timeStart);\
      ObjectSetDouble(0, rName,  OBJPROP_PRICE, 0, ob.high);\
      ObjectSetDouble(0, rName,  OBJPROP_PRICE, 1, ob.low);\
      ObjectSetInteger(0, rName, OBJPROP_TIME,  1, endT);\
      ObjectSetInteger(0, rName, OBJPROP_COLOR, clr);\
   \}\
   if(InpOB_LabelMode != LABEL_OFF)\
   \{\
      string sTypeLbl = (ob.structType == STRUCT_BOS) ? "BOS" : "CHoCH";\
      string dirLbl   = isBull ? "Bull" : "Bear";\
      string touchTxt = (ob.touchCount > 0) ? " D:" + IntegerToString(ob.touchCount) : "";\
      string htf1Lbl  = EnumToString(InpHTF2_TF); StringReplace(htf1Lbl, "PERIOD_", "");\
      string txt = StringFormat("[%s] %s %s %.2f-%.2f%s", htf1Lbl, dirLbl, sTypeLbl, ob.low, ob.high, touchTxt);\
      datetime labelTime = endT - (datetime)((long)PeriodSeconds() * 2);\
      double   labelPrice = (ob.high + ob.low) / 2.0;\
      if(ObjectFind(0, lName) < 0)\
      \{\
         ObjectCreate(0, lName, OBJ_TEXT, 0, labelTime, labelPrice);\
         ObjectSetString(0,  lName, OBJPROP_TEXT,      txt);\
         ObjectSetInteger(0, lName, OBJPROP_COLOR,     clr);\
         ObjectSetInteger(0, lName, OBJPROP_FONTSIZE,  InpDashFontSize);\
         ObjectSetString(0,  lName, OBJPROP_FONT,      "Arial");\
         ObjectSetInteger(0, lName, OBJPROP_ANCHOR,    ANCHOR_RIGHT);\
         ObjectSetInteger(0, lName, OBJPROP_SELECTABLE,false);\
         ObjectSetInteger(0, lName, OBJPROP_HIDDEN,    true);\
      \}\
      else\
      \{\
         ObjectSetString(0,  lName, OBJPROP_TEXT,  txt);\
         ObjectSetInteger(0, lName, OBJPROP_COLOR, clr);\
         ObjectSetInteger(0, lName, OBJPROP_TIME,  0, labelTime);\
         ObjectSetDouble(0,  lName, OBJPROP_PRICE, 0, labelPrice);\
      \}\
   \}\
   else ObjectDelete(0, lName);\
\}\
