\
void OB_ExtractArrays(MqlRates &rates[], int count, double &h[], double &l[], double &o[], double &c[], datetime &t[])\
\{\
   ArrayResize(h,count); ArrayResize(l,count); ArrayResize(o,count); ArrayResize(c,count); ArrayResize(t,count);\
   ArraySetAsSeries(h,true); ArraySetAsSeries(l,true); ArraySetAsSeries(o,true); ArraySetAsSeries(c,true); ArraySetAsSeries(t,true);\
   for(int i=0;i<count;i++) \{ h[i]=rates[i].high; l[i]=rates[i].low; o[i]=rates[i].open; c[i]=rates[i].close; t[i]=rates[i].time; \}\
\}\
\
void OB_TryDetectSwing(int pivot, const double &high[], const double &low[], const datetime &time[], int rates_total, SSwingPoint &swH[], SSwingPoint &swL[], int SS)\
\{\
   if(pivot-SS<0||pivot+SS>=rates_total) return;\
   datetime pTime=time[pivot];\
   bool isSH=true;\
   for(int i=1;i<=SS;i++) \{ if(high[pivot+i]>=high[pivot])\{isSH=false;break;\} if(high[pivot-i]>=high[pivot])\{isSH=false;break;\} \}\
   if(isSH&&!OB_SwingExists(swH,pTime)) \{ SSwingPoint sp; sp.price=high[pivot]; sp.time=pTime; sp.barIndex=pivot; sp.broken=false; int sz=ArraySize(swH); ArrayResize(swH,sz+1); swH[sz]=sp; \}\
   bool isSL=true;\
   for(int i=1;i<=SS;i++) \{ if(low[pivot+i]<=low[pivot])\{isSL=false;break;\} if(low[pivot-i]<=low[pivot])\{isSL=false;break;\} \}\
   if(isSL&&!OB_SwingExists(swL,pTime)) \{ SSwingPoint sp; sp.price=low[pivot]; sp.time=pTime; sp.barIndex=pivot; sp.broken=false; int sz=ArraySize(swL); ArrayResize(swL,sz+1); swL[sz]=sp; \}\
\}\
\
bool OB_SwingExists(SSwingPoint &arr[], datetime t)\
\{\
   int sz=ArraySize(arr);\
   for(int i=sz-1;i>=MathMax(0,sz-5);i--) if(arr[i].time==t) return true;\
   return false;\
\}\
\
void OB_CheckBreaksAtBar(int barIdx, const double &high[], const double &low[], const double &open[], const double &close[], const datetime &time[], int rates_total, bool isRealtime, SSwingPoint &swH[], SSwingPoint &swL[], SOB_Zone &obArr[], int &obCount, long &obId, int &trend, bool requireFVG, double fvgMinPts, int maxOBCount, double obExtPts, double minZonePts, double maxZonePts, bool drawStructLines)\
\{\
   double barClose=close[barIdx]; datetime barTime=time[barIdx];\
   int bestSH=-1,bestBI=999999,shCount=ArraySize(swH);\
   for(int i=0;i<shCount;i++) \{ if(swH[i].broken)continue; if(swH[i].barIndex<=barIdx)continue; if(swH[i].barIndex<bestBI)\{bestSH=i;bestBI=swH[i].barIndex;\} \}\
   if(bestSH>=0&&barClose>swH[bestSH].price)\
   \{\
      swH[bestSH].broken=true;\
      ENUM_STRUCTURE_TYPE sType=(trend<=0)?STRUCT_CHOCH:STRUCT_BOS;\
      trend=1;\
      int obBar=OB_FindOBCandle(OB_BULLISH,swH[bestSH].barIndex,open,close,rates_total);\
      if(obBar>=0)\
      \{\
         bool fvgOk=true; double fH=0,fL=0;\
         if(requireFVG) fvgOk=OB_DetectFVG(obBar,OB_BULLISH,high,low,fH,fL,rates_total,fvgMinPts);\
         if(fvgOk)\
         \{\
            OB_AddGeneric(OB_BULLISH,sType,high[obBar],low[obBar],time[obBar],barTime,fH,fL,isRealtime,obArr,obCount,obId,maxOBCount,obExtPts,minZonePts,maxZonePts,drawStructLines);\
            if(drawStructLines&&InpShowBOS_Lines) OB_DrawStructLine(sType,swH[bestSH].price,swH[bestSH].time,barTime);\
         \}\
      \}\
   \}\
   int bestSL=-1; bestBI=999999; int slCount=ArraySize(swL);\
   for(int i=0;i<slCount;i++) \{ if(swL[i].broken)continue; if(swL[i].barIndex<=barIdx)continue; if(swL[i].barIndex<bestBI)\{bestSL=i;bestBI=swL[i].barIndex;\} \}\
   if(bestSL>=0&&barClose<swL[bestSL].price)\
   \{\
      swL[bestSL].broken=true;\
      ENUM_STRUCTURE_TYPE sType=(trend>=0)?STRUCT_CHOCH:STRUCT_BOS;\
      trend=-1;\
      int obBar=OB_FindOBCandle(OB_BEARISH,swL[bestSL].barIndex,open,close,rates_total);\
      if(obBar>=0)\
      \{\
         bool fvgOk=true; double fH=0,fL=0;\
         if(requireFVG) fvgOk=OB_DetectFVG(obBar,OB_BEARISH,high,low,fH,fL,rates_total,fvgMinPts);\
         if(fvgOk)\
         \{\
            OB_AddGeneric(OB_BEARISH,sType,high[obBar],low[obBar],time[obBar],barTime,fH,fL,isRealtime,obArr,obCount,obId,maxOBCount,obExtPts,minZonePts,maxZonePts,drawStructLines);\
            if(drawStructLines&&InpShowBOS_Lines) OB_DrawStructLine(sType,swL[bestSL].price,swL[bestSL].time,barTime);\
         \}\
      \}\
   \}\
\}\
\
int OB_FindOBCandle(ENUM_OB_TYPE obType, int swingBar, const double &open[], const double &close[], int rates_total)\
\{\
   int limit=MathMin(swingBar+15,rates_total-1);\
   for(int i=swingBar;i<=limit;i++) \{ if(obType==OB_BULLISH&&close[i]<open[i])return i; if(obType==OB_BEARISH&&close[i]>open[i])return i; \}\
   return -1;\
\}\
\
bool OB_DetectFVG(int obBar, ENUM_OB_TYPE obType, const double &high[], const double &low[], double &fvgH, double &fvgL, int rates_total, double fvgMinPts)\
\{\
   int impulseBar=obBar-1;\
   if(impulseBar<1||obBar+1>=rates_total) return false;\
   if(obType==OB_BULLISH) \{ double gL=high[obBar],gH=low[impulseBar-1]; if(gH>gL&&(gH-gL)/g_Pt>=fvgMinPts)\{fvgH=gH;fvgL=gL;return true;\} \}\
   else \{ double gH=low[obBar],gL=high[impulseBar-1]; if(gH>gL&&(gH-gL)/g_Pt>=fvgMinPts)\{fvgH=gH;fvgL=gL;return true;\} \}\
   return false;\
\}\
\
void OB_AddGeneric(ENUM_OB_TYPE type, ENUM_STRUCTURE_TYPE sType, double zH, double zL, datetime candleTime, datetime brkTime, double fH, double fL, bool isRealtime, SOB_Zone &obArr[], int &obCount, long &obId, int maxOBCount, double obExtPts, double minZonePts, double maxZonePts, bool isPrimary)\
\{\
   if(obCount >= maxOBCount) OB_RemoveOldestGeneric(obArr, obCount);\
   double ext=obExtPts*g_Pt;\
   if(type==OB_BULLISH) zL-=ext; else zH+=ext;\
   double sizePts=(zH-zL)/g_Pt;\
   if(minZonePts>0&&sizePts<minZonePts) return;\
   if(maxZonePts>0&&sizePts>maxZonePts) return;\
   for(int i=0;i<obCount;i++) if(obArr[i].timeStart==candleTime&&MathAbs(obArr[i].high-zH)<g_Pt) return;\
   SOB_Zone ob;\
   ob.id=++obId; ob.type=type; ob.structType=sType;\
   ob.status=OB_FRESH; ob.high=zH; ob.low=zL; ob.poc=(zH+zL)/2.0;\
   ob.timeStart=candleTime; ob.breakTime=brkTime;\
   ob.touchCount=0; ob.lastTouchTime=0; ob.isCurrentlyInside=false;\
   ob.hasFVG=(fH>0); ob.fvgHigh=fH; ob.fvgLow=fL;\
   ob.clusterSize=1; ob.clusterHidden=false;\
   ob.cfScore=0; ob.cfTier=TIER_3; ob.cfDetail=""; ob.cfAlerted=false;\
   ob.proximityAlerted=false; ob.sweepAlerted=false; ob.mitigatedAlerted=false;\
