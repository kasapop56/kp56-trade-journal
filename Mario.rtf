                          InpRequireFVG, InpFVG_MinSize_Pts, InpMaxOB_Count, InpOB_Extension_Pts, InpMinZone_Pts, InpMaxZone_Pts, true);\
   OB_CheckBreaksAtBar(0, hH, hL, hO, hC, hT, copied, true,\
                       g_SwH, g_SwL, g_OB, g_OB_Count, g_OB_Id, g_Trend,\
                       InpRequireFVG, InpFVG_MinSize_Pts, InpMaxOB_Count, InpOB_Extension_Pts, InpMinZone_Pts, InpMaxZone_Pts, true);\
