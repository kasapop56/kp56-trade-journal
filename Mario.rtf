// \uc0\u9556 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9559 \
// \uc0\u9553        ENGINE 2A \'97 PRIMARY OB (M5)                                 \u9553 \
// \uc0\u9562 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9552 \u9565 \
\
bool OB_FullScanHTF(bool silent = false)\
\{\
   MqlRates htf[];\
   int copied = CopyRates(_Symbol, InpOB_Timeframe, 0, InpLookback_Bars, htf);\
   if(copied < InpSwingStrength * 2 + 10)\
   \{ if(InpDebugPrint) Print("OB v3.0: Insufficient data: copied=", copied); return false; \}\
   if(!silent) Print("OB v3.0 PRIMARY: CopyRates got ", copied, " bars of ", EnumToString(InpOB_Timeframe));\
   ArraySetAsSeries(htf, true);\
   double hH[], hL[], hO[], hC[]; datetime hT[];\
   OB_ExtractArrays(htf, copied, hH, hL, hO, hC, hT);\
   int SS = InpSwingStrength;\
   int scanStart = MathMin(InpLookback_Bars, copied - SS - 1);\
   g_OB_Count = 0; g_OB_Id = 0; g_Trend = 0;\
   ArrayResize(g_OB, 0, InpMaxOB_Count + 10);\
   ArrayResize(g_SwH, 0, 200);\
   ArrayResize(g_SwL, 0, 200);\
   int dbg_Created=0,dbg_BullCreated=0,dbg_BearCreated=0,dbg_Mitigated=0;\
   for(int bar = scanStart; bar >= 0; bar--)\
   \{\
      int prevOB = g_OB_Count;\
      int pivotCandidate = bar + SS;\
      if(pivotCandidate + SS < copied)\
         OB_TryDetectSwing(pivotCandidate, hH, hL, hT, copied, g_SwH, g_SwL, SS);\
      OB_CheckBreaksAtBar(bar, hH, hL, hO, hC, hT, copied, false,\
                          g_SwH, g_SwL, g_OB, g_OB_Count, g_OB_Id, g_Trend,\
                          InpRequireFVG, InpFVG_MinSize_Pts,\
                          InpMaxOB_Count, InpOB_Extension_Pts,\
                          InpMinZone_Pts, InpMaxZone_Pts, true);\
      if(!silent)\
      \{\
         for(int n = prevOB; n < g_OB_Count; n++)\
         \{ dbg_Created++; if(g_OB[n].type==OB_BULLISH) dbg_BullCreated++; else dbg_BearCreated++; \}\
         int mitBefore=0;\
         for(int m=0;m<g_OB_Count;m++) if(g_OB[m].status==OB_MITIGATED) mitBefore++;\
         OB_CheckMitigationGeneric(bar, hH, hL, hC, hT, g_OB, g_OB_Count);\
         int mitAfter=0;\
         for(int m=0;m<g_OB_Count;m++) if(g_OB[m].status==OB_MITIGATED) mitAfter++;\
         dbg_Mitigated += (mitAfter - mitBefore);\
      \}\
      else OB_CheckMitigationGeneric(bar, hH, hL, hC, hT, g_OB, g_OB_Count);\
   \}\
   OB_GarbageCollect();\
   for(int i = 0; i < g_OB_Count; i++) if(g_OB[i].touchCount > 0) g_OB[i].cfAlerted = true;\
   int survBull=0,survBear=0,survTested=0;\
   for(int i=0;i<g_OB_Count;i++) \{ if(g_OB[i].type==OB_BULLISH)survBull++;else survBear++; if(g_OB[i].status==OB_TESTED_1)survTested++; \}\
   if(!silent)\
      Print("OB v5.61 PRIMARY: Scan done \'97 Created=", dbg_Created, " Survived=", g_OB_Count, " (Bull:", survBull, " Bear:", survBear, " Tested:", survTested, ") Ghost=", g_Ghost_Count, " Trend=", g_Trend);\
   return true;\
\}\
\
void OB_PostScanM1Mitigation()\
\{\
   MqlRates m1[];\
   int copied = CopyRates(_Symbol, PERIOD_M1, TimeCurrent()-3*86400, TimeCurrent(), m1);\
   if(copied <= 0) return;\
   int mitCount = 0;\
   for(int b = 0; b < copied; b++)\
   \{\
      for(int i = 0; i < g_OB_Count; i++)\
      \{\
         if(g_OB[i].status == OB_MITIGATED) continue;\
         datetime protectedUntil = g_OB[i].breakTime + (datetime)PeriodSeconds(InpOB_Timeframe);\
         if(protectedUntil > m1[b].time) continue;\
         double zH=g_OB[i].high, zL=g_OB[i].low;\
         bool fullMit = false;\
         if(g_OB[i].type==OB_BULLISH && m1[b].close<zL) fullMit=true;\
         if(g_OB[i].type==OB_BEARISH && m1[b].close>zH) fullMit=true;\
         if(fullMit) \{ g_OB[i].status=OB_MITIGATED; g_OB[i].touchCount++; g_OB[i].lastTouchTime=m1[b].time; mitCount++; \}\
      \}\
   \}\
   if(mitCount > 0) \{ OB_GarbageCollect(); Print("M1_MIT: Removed ", mitCount, " zones that M5 scan missed"); \}\
\}\
