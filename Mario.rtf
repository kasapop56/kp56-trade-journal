void CheckSweepAlerts(double barHigh, double barLow, double barClose, double barOpen, datetime now)\
\{\
   static datetime lastSweepTime=0;\
   if(now-lastSweepTime<60) return;\
   double maxPierce=InpAlert_Sweep_Pts*g_Pt;\
   for(int i=0;i<g_OB_Count;i++)\
   \{\
      if(g_OB[i].status==OB_MITIGATED||g_OB[i].clusterHidden) continue;\
      if(g_OB[i].sweepAlerted) continue;\
      if(g_OB[i].breakTime>=now) continue;\
      if((int)g_OB[i].cfTier>(int)InpSweep_MinTier) continue;\
      double zH=g_OB[i].high,zL=g_OB[i].low;\
      bool swept=false;string sweepDir="";double pierceAmount=0;\
      if(g_OB[i].type==OB_BULLISH)\{double pierce=zL-barLow;if(pierce>0&&pierce<=maxPierce&&barClose>=zL)\{swept=true;sweepDir="BULL SWEEP";pierceAmount=pierce;\}\}\
      else\{double pierce=barHigh-zH;if(pierce>0&&pierce<=maxPierce&&barClose<=zH)\{swept=true;sweepDir="BEAR SWEEP";pierceAmount=pierce;\}\}\
      if(!swept) continue;\
      string tierStr=OB_TierStr(g_OB[i].cfTier);\
      string priTag=EnumToString(InpOB_Timeframe);StringReplace(priTag,"PERIOD_","");\
      int piercePts=(int)MathRound(pierceAmount/g_Pt);\
      string htfInfo=(g_OB[i].cfHTF_Locked>0)?" "+g_OB[i].cfHTF_DetailLocked:"";\
      double bodySize=MathAbs(barClose-barOpen),fullRange=barHigh-barLow;\
      string rejType="";\
      if(fullRange>0&&bodySize/fullRange<0.35)rejType=" Pinbar";\
      else if(fullRange>0&&bodySize/fullRange<0.50)rejType=" Rejection";\
      string msg=StringFormat("%s%s [%s:%d]%s\\nZone: %.2f - %.2f (%s)\\nPierce: %d pts | Close: %.2f\\n%s\\n%s",sweepDir,rejType,tierStr,g_OB[i].cfScore,htfInfo,g_OB[i].low,g_OB[i].high,priTag,piercePts,barClose,TG_SafeStr(g_OB[i].cfDetail),_Symbol);\
      if(InpMT5_Sweep)\{Alert("SWEEP "+msg);if(InpMT5_Push)SendNotification("SWEEP "+msg);\}\
      if(InpTG_Enabled&&InpTG_Sweep) SendToTGQueue("SWEEP\\n"+msg);\
      g_OB[i].sweepAlerted=true; lastSweepTime=now; break;\
   \}\
\}\
