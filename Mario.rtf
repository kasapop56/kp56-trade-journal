string BuildHTFDetail(double obH, double obL, ENUM_OB_TYPE obType)\
\{\
   bool m15hit = false, h1hit = false;\
   if(InpHTF_Enabled && g_CF_Ready)\
      for(int j = 0; j < g_CF_OB_Count && !m15hit; j++)\
         if(g_CF_OB[j].status != OB_MITIGATED && g_CF_OB[j].type == obType)\
            if(obL <= g_CF_OB[j].high && obH >= g_CF_OB[j].low) m15hit = true;\
   if(InpHTF2_Enabled && g_HTF2_Ready)\
      for(int j = 0; j < g_HTF2_OB_Count && !h1hit; j++)\
         if(g_HTF2_OB[j].status != OB_MITIGATED && g_HTF2_OB[j].type == obType)\
            if(obL <= g_HTF2_OB[j].high && obH >= g_HTF2_OB[j].low) h1hit = true;\
   if(m15hit && h1hit) return "M15+H1";\
   if(h1hit)           return "H1";\
   if(m15hit)          return "M15";\
   return "";\
\}\
\
void ScoreAllOBs()\
\{\
   g_stat_TierS=0;g_stat_Tier1=0;g_stat_Tier2=0;g_stat_Tier3=0;\
   g_stat_TotalScored=0;double totalScore=0;g_stat_HTF_Confirmed=0;\
   double todayPOC=0,todayVAH=0,todayVAL=0,prevPOC=0,prevVAH=0,prevVAL=0;\
   double sessionPOC[3]=\{0,0,0\};\
   if(g_DayCount>0)\{int t=g_DayCount-1;todayPOC=g_Days[t].compositePOC;todayVAH=g_Days[t].compositeVAH;todayVAL=g_Days[t].compositeVAL;for(int s=0;s<3;s++)sessionPOC[s]=g_Days[t].sessions[s].pocPrice;\}\
   if(g_DayCount>=2)\{int p=g_DayCount-2;prevPOC=g_Days[p].compositePOC;prevVAH=g_Days[p].compositeVAH;prevVAL=g_Days[p].compositeVAL;\}\
   double radius=InpConfluence_Radius_Pts*g_Pt;\
   ENUM_SESSION_TYPE curSes; bool hasCurSes=SVP_GetSessionType(TimeCurrent(),curSes);\
   for(int i=0;i<g_OB_Count;i++)\
   \{\
      if(g_OB[i].status==OB_MITIGATED||g_OB[i].clusterHidden) continue;\
      int score=0;string detail="";\
      double obH=g_OB[i].high,obL=g_OB[i].low,obMid=g_OB[i].poc;\
      int svpScore=0;string svpDetail="";\
      if(todayPOC>0&&IsNearZone(obH,obL,todayPOC,radius))\{svpScore+=40;svpDetail+="POC";\}\
      if(todayVAH>0&&IsNearZone(obH,obL,todayVAH,radius))\{svpScore=MathMax(svpScore,30);AppendDetail(svpDetail,"VAH");\}\
      if(todayVAL>0&&IsNearZone(obH,obL,todayVAL,radius))\{svpScore=MathMax(svpScore,30);AppendDetail(svpDetail,"VAL");\}\
      if(todayVAH>0&&todayVAL>0&&obMid>=todayVAL&&obMid<=todayVAH&&svpScore<30)\{svpScore+=15;AppendDetail(svpDetail,"inVA");\}\
      if(prevPOC>0&&IsNearZone(obH,obL,prevPOC,radius))\{svpScore+=25;AppendDetail(svpDetail,"pPOC");\}\
      if(prevVAH>0&&IsNearZone(obH,obL,prevVAH,radius))\{svpScore+=12;AppendDetail(svpDetail,"pVAH");\}\
      if(prevVAL>0&&IsNearZone(obH,obL,prevVAL,radius))\{svpScore+=12;AppendDetail(svpDetail,"pVAL");\}\
      int sessionBonus=0;\
      for(int s=0;s<3;s++)\{if(sessionPOC[s]>0&&IsNearZone(obH,obL,sessionPOC[s],radius))\{sessionBonus+=8;AppendDetail(svpDetail,(s==0?"sPOC_A":(s==1?"sPOC_L":"sPOC_N")));\}\}\
      svpScore+=MathMin(sessionBonus,16);\
      int currentSVP=MathMin(svpScore,40);\
      if(currentSVP>g_OB[i].cfSVP_Locked)\{g_OB[i].cfSVP_Locked=currentSVP;g_OB[i].cfSVP_DetailLocked=svpDetail;\}\
      score+=g_OB[i].cfSVP_Locked;\
      if(g_OB[i].cfSVP_Locked>currentSVP) detail=g_OB[i].cfSVP_DetailLocked; else detail=svpDetail;\
      int obQ=0;\
      if(g_OB[i].structType==STRUCT_CHOCH)\{obQ+=15;AppendDetail(detail,"CHoCH");\}else\{obQ+=5;AppendDetail(detail,"BOS");\}\
      if(g_OB[i].hasFVG)\{obQ+=10;AppendDetail(detail,"FVG");\}\
      if(g_OB[i].status==OB_FRESH) obQ+=5;\
      double zonePts=(obH-obL)/g_Pt;\
      if(zonePts>0&&zonePts<500.0) obQ+=5;\
      score+=MathMin(obQ,35);\
      int clBonus=MathMin((g_OB[i].clusterSize-1)*5,15);\
      if(clBonus>0)\{score+=clBonus;AppendDetail(detail,"x"+IntegerToString(g_OB[i].clusterSize));\}\
      if(hasCurSes)\{ENUM_SESSION_TYPE obSes;if(SVP_GetSessionType(g_OB[i].timeStart,obSes))\{if(obSes==curSes)\{score+=10;AppendDetail(detail,"ActSes");\}\}\}\
      if(InpHTF_Enabled || InpHTF2_Enabled)\
      \{\
         int currentHTF = GetHTFOverlapBonus(obH, obL, g_OB[i].type);\
         string htfDetail = BuildHTFDetail(obH, obL, g_OB[i].type);\
         if(currentHTF > g_OB[i].cfHTF_Locked) \{ g_OB[i].cfHTF_Locked = currentHTF; g_OB[i].cfHTF_DetailLocked = htfDetail; \}\
         if(g_OB[i].cfHTF_Locked > 0) \{ score += g_OB[i].cfHTF_Locked; AppendDetail(detail, g_OB[i].cfHTF_DetailLocked); \}\
         if(currentHTF > 0) g_stat_HTF_Confirmed++;\
      \}\
      if(g_OB[i].touchCount>0&&InpTouchBonus_Score>0)\{int touchBonus=MathMin(g_OB[i].touchCount*InpTouchBonus_Score,15);score+=touchBonus;AppendDetail(detail,"Def:"+IntegerToString(g_OB[i].touchCount));\}\
      score=MathMin(score,100);\
      g_OB[i].cfScore=score; g_OB[i].cfDetail=detail;\
      if(score>=InpTierS_Threshold) g_OB[i].cfTier=TIER_S;\
      else if(score>=InpTier1_Threshold) g_OB[i].cfTier=TIER_1;\
      else if(score>=InpTier2_Threshold) g_OB[i].cfTier=TIER_2;\
      else g_OB[i].cfTier=TIER_3;\
      g_stat_TotalScored++;totalScore+=score;\
      switch(g_OB[i].cfTier)\{case TIER_S:g_stat_TierS++;break;case TIER_1:g_stat_Tier1++;break;case TIER_2:g_stat_Tier2++;break;case TIER_3:g_stat_Tier3++;break;\}\
   \}\
   g_stat_AvgScore=(g_stat_TotalScored>0)?totalScore/g_stat_TotalScored:0;\
\}\
\
int GetHTFOverlapBonus(double obH, double obL, ENUM_OB_TYPE obType)\
\{\
   int htf1Bonus = 0;\
   int htf2Bonus = 0;\
   if(InpHTF_Enabled)\
   \{\
      for(int j = 0; j < g_CF_OB_Count; j++)\
      \{\
         if(g_CF_OB[j].status == OB_MITIGATED) continue;\
         if(g_CF_OB[j].type  != obType)        continue;\
         if(obL <= g_CF_OB[j].high && obH >= g_CF_OB[j].low)\
         \{\
            int b = (g_CF_OB[j].structType == STRUCT_CHOCH) ? InpHTF_Bonus_CHoCH : InpHTF_Bonus_BOS;\
            if(b > htf1Bonus) htf1Bonus = b;\
         \}\
      \}\
   \}\
   if(InpHTF2_Enabled && g_HTF2_Ready)\
   \{\
      for(int j = 0; j < g_HTF2_OB_Count; j++)\
      \{\
         if(g_HTF2_OB[j].status == OB_MITIGATED) continue;\
         if(g_HTF2_OB[j].type  != obType)        continue;\
         if(obL <= g_HTF2_OB[j].high && obH >= g_HTF2_OB[j].low)\
         \{\
            int b = (g_HTF2_OB[j].structType == STRUCT_CHOCH) ? InpHTF2_Bonus_CHoCH : InpHTF2_Bonus_BOS;\
            if(b > htf2Bonus) htf2Bonus = b;\
         \}\
      \}\
   \}\
   return MathMin(htf1Bonus + htf2Bonus, 40);\
\}\
\
bool IsNearZone(double zH, double zL, double level, double radius)\
\{\
   if(level>=zL&&level<=zH) return true;\
   if(MathAbs(level-zH)<=radius) return true;\
   if(MathAbs(level-zL)<=radius) return true;\
   return false;\
\}\
\
void AppendDetail(string &detail, string item)\
\{ if(StringLen(detail)>0) detail+="+"; detail+=item; \}\
