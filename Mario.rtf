         g_OB[i].status=OB_MITIGATED; g_OB[i].touchCount++; g_OB[i].lastTouchTime=barTime; g_OB[i].isCurrentlyInside=false;\
         if(!g_OB[i].mitigatedAlerted&&g_OB_Ready)\
