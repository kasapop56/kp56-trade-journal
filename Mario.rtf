void SVP_DrawTodayProfile(int dIdx, datetime now)\
\{\
   int nRows=g_Days[dIdx].rowCount; if(nRows==0) return;\
   double rowSize=InpRowSize_Points*g_Pt; long barDur=PeriodSeconds();\
   double maxVol=0;\
   for(int r=0;r<nRows;r++) if(g_Days[dIdx].rows[r].totalVol>maxVol) maxVol=g_Days[dIdx].rows[r].totalVol;\
   if(maxVol==0) return;\
   datetime histStart=now+(datetime)((long)barDur*InpHistOffset);\
   for(int r=0;r<nRows;r++)\
   \{\
      double rTop=g_Days[dIdx].rows[r].price+rowSize/2.0,rBot=g_Days[dIdx].rows[r].price-rowSize/2.0;\
      double aVol=g_Days[dIdx].rows[r].asiaVol,lVol=g_Days[dIdx].rows[r].londonVol,nVol=g_Days[dIdx].rows[r].nyVol,tVol=g_Days[dIdx].rows[r].totalVol;\
      if(tVol==0) continue;\
      double totalRatio=tVol/maxVol; int totalBars=MathMax(1,(int)(InpHistBars*totalRatio));\
      int aBars=(int)(totalBars*(aVol/tVol)),lBars=(int)(totalBars*(lVol/tVol)),nBars=totalBars-aBars-lBars;\
      datetime cursor=histStart;\
      if(aBars>0)\{datetime e=(datetime)(cursor+aBars*barDur);SVP_DrawRect(StringFormat("SVP_HA_%d_%d",dIdx,r),cursor,rTop,e,rBot,InpAsia_Color,InpHistFill);cursor=e;\}\
      if(lBars>0)\{datetime e=(datetime)(cursor+lBars*barDur);SVP_DrawRect(StringFormat("SVP_HL_%d_%d",dIdx,r),cursor,rTop,e,rBot,InpLondon_Color,InpHistFill);cursor=e;\}\
      if(nBars>0)\{datetime e=(datetime)(cursor+nBars*barDur);SVP_DrawRect(StringFormat("SVP_HN_%d_%d",dIdx,r),cursor,rTop,e,rBot,InpNY_Color,InpHistFill);\}\
   \}\
   SVP_DrawTrend("SVP_CPOC",g_Days[dIdx].firstBarTime,g_Days[dIdx].compositePOC,now,g_Days[dIdx].compositePOC,InpPOC_Color,STYLE_SOLID,2);\
   SVP_DrawTrend("SVP_CVAH",g_Days[dIdx].firstBarTime,g_Days[dIdx].compositeVAH,now,g_Days[dIdx].compositeVAH,InpVAH_Color,STYLE_DASH,1);\
   SVP_DrawTrend("SVP_CVAL",g_Days[dIdx].firstBarTime,g_Days[dIdx].compositeVAL,now,g_Days[dIdx].compositeVAL,InpVAL_Color,STYLE_DASH,1);\
   color sPocC[3];sPocC[0]=InpAsia_Color;sPocC[1]=InpLondon_Color;sPocC[2]=InpNY_Color;\
   for(int s=0;s<3;s++)\{if(g_Days[dIdx].sessions[s].pocPrice==0||g_Days[dIdx].sessions[s].tStart==0)continue;SVP_DrawTrend(StringFormat("SVP_SPOC_%d_%d",dIdx,s),g_Days[dIdx].sessions[s].tStart,g_Days[dIdx].sessions[s].pocPrice,now,g_Days[dIdx].sessions[s].pocPrice,sPocC[s],STYLE_DOT,1);\}\
\}\
