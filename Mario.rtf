\
bool CF_FullScan(bool silent = false)\
\{\
   MqlRates htf[];\
   int copied = CopyRates(_Symbol, InpHTF_Confirm_TF, 0, InpHTF_Lookback, htf);\
   if(copied < InpHTF_SwingStr * 2 + 10) \{ if(InpDebugPrint) Print("HTF1 CONFIRM: Insufficient data: copied=", copied); return false; \}\
   if(!silent) Print("HTF1 CONFIRM: CopyRates got ", copied, " bars of ", EnumToString(InpHTF_Confirm_TF));\
   ArraySetAsSeries(htf, true);\
   double hH[],hL[],hO[],hC[]; datetime hT[];\
   OB_ExtractArrays(htf, copied, hH, hL, hO, hC, hT);\
   int SS = InpHTF_SwingStr;\
   int scanStart = MathMin(InpHTF_Lookback, copied - SS - 1);\
   g_CF_OB_Count=0; g_CF_OB_Id=0; g_CF_Trend=0;\
   ArrayResize(g_CF_OB, 0, InpHTF_MaxOB + 10);\
   ArrayResize(g_CF_SwH, 0, 200);\
   ArrayResize(g_CF_SwL, 0, 200);\
   for(int bar = scanStart; bar >= 0; bar--)\
   \{\
      int pivotCandidate = bar + SS;\
      if(pivotCandidate + SS < copied)\
         OB_TryDetectSwing(pivotCandidate, hH, hL, hT, copied, g_CF_SwH, g_CF_SwL, SS);\
      OB_CheckBreaksAtBar(bar, hH, hL, hO, hC, hT, copied, false,\
                          g_CF_SwH, g_CF_SwL, g_CF_OB, g_CF_OB_Count, g_CF_OB_Id, g_CF_Trend,\
                          false, 0, InpHTF_MaxOB, 0, InpHTF_MinZone_Pts, InpHTF_MaxZone_Pts, false);\
      OB_CheckMitigationGeneric(bar, hH, hL, hC, hT, g_CF_OB, g_CF_OB_Count);\
   \}\
   CF_GarbageCollect();\
   if(!silent) Print("HTF1 CONFIRM: Scan done \'97 Survived=", g_CF_OB_Count);\
   return true;\
\}\
\
void CF_Incremental()\
\{\
   OB_ShiftSwingIndices(g_CF_SwH, g_CF_SwL, InpHTF_Lookback);\
   int need = InpHTF_SwingStr * 2 + 5;\
   MqlRates htf[];\
   int copied = CopyRates(_Symbol, InpHTF_Confirm_TF, 0, need, htf);\
   if(copied < need) return;\
   ArraySetAsSeries(htf, true);\
   double hH[],hL[],hO[],hC[]; datetime hT[];\
   OB_ExtractArrays(htf, copied, hH, hL, hO, hC, hT);\
   OB_TryDetectSwing(InpHTF_SwingStr, hH, hL, hT, copied, g_CF_SwH, g_CF_SwL, InpHTF_SwingStr);\
   OB_CheckBreaksAtBar(0, hH, hL, hO, hC, hT, copied, true,\
                       g_CF_SwH, g_CF_SwL, g_CF_OB, g_CF_OB_Count, g_CF_OB_Id, g_CF_Trend,\
                       false, 0, InpHTF_MaxOB, 0, InpHTF_MinZone_Pts, InpHTF_MaxZone_Pts, false);\
\}\
\
void CF_CheckMitigationCurrent(double barHigh, double barLow, double barClose, datetime barTime)\
\{\
   for(int i = 0; i < g_CF_OB_Count; i++)\
   \{\
      if(g_CF_OB[i].status == OB_MITIGATED) continue;\
      datetime protectedUntil = g_CF_OB[i].breakTime + (datetime)PeriodSeconds(InpHTF_Confirm_TF);\
      if(protectedUntil > barTime) continue;\
      double zH=g_CF_OB[i].high, zL=g_CF_OB[i].low;\
      bool fullMit = false;\
      if(g_CF_OB[i].type==OB_BULLISH && barClose<zL) fullMit=true;\
      if(g_CF_OB[i].type==OB_BEARISH && barClose>zH) fullMit=true;\
      if(fullMit) \{ g_CF_OB[i].status=OB_MITIGATED; g_CF_OB[i].touchCount++; g_CF_OB[i].lastTouchTime=barTime; g_CF_OB[i].isCurrentlyInside=false; continue; \}\
      bool entered = (barLow <= zH && barHigh >= zL);\
      if(!entered) \{ g_CF_OB[i].isCurrentlyInside=false; continue; \}\
      if(barTime != g_CF_OB[i].lastTouchTime)\
      \{ g_CF_OB[i].lastTouchTime=barTime; if(!g_CF_OB[i].isCurrentlyInside) \{ g_CF_OB[i].touchCount++; g_CF_OB[i].status=OB_TESTED_1; \} \}\
      g_CF_OB[i].isCurrentlyInside=true;\
   \}\
\}\
\
void CF_GarbageCollect()\
\{\
   int w=0;\
   for(int i=0;i<g_CF_OB_Count;i++) \{ if(g_CF_OB[i].status==OB_MITIGATED) continue; if(w!=i) g_CF_OB[w]=g_CF_OB[i]; w++; \}\
   if(w!=g_CF_OB_Count) \{ g_CF_OB_Count=w; ArrayResize(g_CF_OB,g_CF_OB_Count); \}\
\}\
